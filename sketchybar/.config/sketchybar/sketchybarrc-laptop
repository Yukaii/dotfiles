#!/bin/bash

source "$HOME/.config/sketchybar/colors.sh"

FONT_FACE="SF Pro Rounded"
PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# Bar Configuration for Laptop (minimal style)
sketchybar --bar \
    height=54 \
    color=$BAR_COLOR \
    blur_radius=24 \
    margin=0 \
    sticky=on \
    padding_left=5 \
    padding_right=10 \
    notch_width=188 \
    display=main

# Default item configuration (minimal style)
sketchybar --default \
    background.color=$ITEM_BG_COLOR \
    background.corner_radius=10 \
    background.padding_left=10 \
    background.padding_right=10 \
    icon.font="$FONT_FACE:Black:15.0" \
    icon.color=$TEXT_PRIMARY \
    icon.padding_left=10 \
    icon.padding_right=10 \
    label.font="$FONT_FACE:Black:13.0" \
    label.color=$TEXT_PRIMARY \
    label.padding_left=10 \
    label.padding_right=10 \
    label.align=center

# Mission Control Spaces (minimal style)
for sid in {1..5}
do
  sketchybar --add space space.$sid left \
             --set space.$sid \
             space=$sid \
             icon=$sid \
             icon.font="$FONT_FACE:Black:15.0" \
             icon.color=$TEXT_PRIMARY \
             background.color=$TRANSPARENT \
             background.corner_radius=10 \
             label.drawing=off \
             script="$PLUGIN_DIR/space.sh" \
             click_script="$PLUGIN_DIR/switch_space.sh $sid"
done

# Add spacer after spaces
sketchybar --add item spacer_1 left \
           --set spacer_1 \
           icon= \
           icon.color=$GREY_MEDIUM \
           background.drawing=off

# Front app (minimal style)
sketchybar --add item front_app left \
           --set front_app \
           background.color=$ITEM_BG_COLOR \
           background.corner_radius=10 \
           icon.drawing=off \
           label.font="$FONT_FACE:Black:13.0" \
           label.color=$TEXT_PRIMARY \
           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# Right side items (minimal style)
sketchybar --add item battery right \
           --set battery \
           background.color=$ITEM_BG_COLOR \
           background.corner_radius=10 \
           icon.font="$FONT_FACE:Black:15.0" \
           icon.color=$TEXT_PRIMARY \
           label.font="$FONT_FACE:Black:13.0" \
           label.color=$TEXT_PRIMARY \
           update_freq=20 \
           script="$PLUGIN_DIR/battery.sh"

sketchybar --add item clock right \
           --set clock \
           background.color=$ITEM_BG_COLOR \
           background.corner_radius=10 \
           icon.drawing=off \
           label.font="$FONT_FACE:Black:13.0" \
           label.color=$TEXT_PRIMARY \
           update_freq=10 \
           script="$PLUGIN_DIR/clock.sh"

##### Finalizing Setup #####
sketchybar --update
sketchybar --trigger space_change
