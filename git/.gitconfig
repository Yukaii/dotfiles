[include]
    path = ~/.gitconfig.local

[core]
	; pager = git-split-diffs --color | less -RFX
	pager = hunk pager --fast --sidebar --mode split
	excludesfile = ~/.gitignore_global
	difftool = true
[delta]
    plus-style = "syntax #012800"
    minus-style = "syntax #340001"
    syntax-theme = Monokai Extended
[push]
	autoSetupRemote = true

[interactive]
    diffFilter = delta --color-only
[commit]
	gpgsign = true
[init]
	defaultBranch = main
; [diff]
; 	external = difft
;   tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[alias]
    dft = difftool

    delete-squashed = "!f() { \
      local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
      local targetBranch=${1:-$defaultBranch}; \
      local worktreeBranches=$(git worktree list --porcelain | sed -n 's/^branch refs\\/heads\\///p'); \
      git checkout -q \"$targetBranch\"; \
      git branch --merged \"$targetBranch\" --format='%(refname:short)' | \
        while read branch; do \
          if [[ -n $branch && $branch != \"$targetBranch\" && ! $branch =~ ^(develop|main|master|production|deploy)$ ]]; then \
            if ! printf '%s\\n' \"$worktreeBranches\" | grep -Fxq \"$branch\"; then \
              git branch -d \"$branch\"; \
            fi; \
          fi; \
        done; \
      git for-each-ref refs/heads/ \"--format=%(refname:short)\" | \
        while read branch; do \
          if [[ -n $branch && $branch != \"$targetBranch\" && ! $branch =~ ^(develop|main|master|production|deploy)$ ]]; then \
            if printf '%s\\n' \"$worktreeBranches\" | grep -Fxq \"$branch\"; then \
              continue; \
            fi; \
            local mergeBase=$(git merge-base \"$targetBranch\" \"$branch\"); \
            if [[ -n $mergeBase && $mergeBase != $(git rev-parse \"$branch\") ]]; then \
              local isSquashed=$(git cherry \"$targetBranch\" $(git commit-tree $(git rev-parse \"$branch^{tree}\") -p $mergeBase -m _)); \
              if [[ $isSquashed == \"-\"* ]]; then \
                git branch -D \"$branch\"; \
              fi; \
            fi; \
          fi; \
        done; \
    }; f"

  ff-branch = "!f() { git fetch ${2:-origin} $1:$1; }; f"

  pr-diff = "!f() { \
    local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
    local compareBranch=${1:-$defaultBranch}; \
    git diff $(git merge-base HEAD $compareBranch) HEAD; \
  }; f"

  pr-diff-stat = "!f() { \
    local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
    local compareBranch=${1:-$defaultBranch}; \
    git diff --stat $(git merge-base HEAD $compareBranch) HEAD; \
  }; f"

  pr-diff-files = "!f() { \
    local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
    local compareBranch=${1:-$defaultBranch}; \
    git diff --name-only $(git merge-base HEAD $compareBranch) HEAD; \
  }; f"

  checkout-default = "!f() { \
    local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
    git checkout $defaultBranch; \
  }; f"

  checkout-master = "!f() { \
    local defaultBranch=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'); \
    if git rev-parse --verify main >/dev/null 2>&1; then \
      git checkout main; \
    elif git rev-parse --verify master >/dev/null 2>&1; then \
      git checkout master; \
    else \
      git checkout $defaultBranch; \
    fi; \
  }; f"


[branch]
	sort = -committerdate
[column]
	ui = auto
[rerere]
	enabled = true
	autoUpdate = true
[split-diffs]
  theme-directory = "/Users/yukai/.git-split-diffs/themes/"
	theme-name = min-dark
	; theme-name = solarized-dark
	min-line-width = 40
[gpg]
	program = /opt/homebrew/bin/gpg
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
