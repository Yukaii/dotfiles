<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.user.opencode</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-c</string>
      <string>export PATH="/opt/homebrew/bin:$PATH" &amp;&amp; eval "$(/opt/homebrew/bin/fnm env)" &amp;&amp; /usr/local/bin/opencode serve --port 4096</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/opencode.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/opencode.err</string>
  </dict>
</plist>
