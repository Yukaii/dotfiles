auto-update-channel = tip

font-size                  = 15
theme                      = light:GitHub-Light-Default,dark:kanagawabones

command                    = /opt/homebrew/bin/fish

cursor-style               = block
cursor-style-blink         = false

shell-integration-features = no-cursor

macos-option-as-alt        = true
macos-window-shadow        = false
title                      = " "

window-padding-x           = 10
window-padding-y           = 5

window-height              = 30
window-width               = 100

window-title-font-family   = JetBrainsMono Nerd Font

background-opacity         = 0.9
background-blur-radius     = 25
unfocused-split-opacity    = 0.85

# Font specific config
font-family                = JetBrainsMono Nerd Font
adjust-cell-height         = 3

# font-family                = Berkeley Mono Trial
# adjust-cell-height         = 6

# Quick terminal

quick-terminal-animation-duration = 0
quick-terminal-position           = bottom

macos-icon = xray

# Shaders
# custom-shader = shaders/bettercrt.glsl
# custom-shader = shaders/underwater.glsl
custom-shader = my_shaders/cursor-trail.glsl
# custom-shader = cursor_shaders/shaders/cursor_blaze_no_trail.glsl
# custom-shader = shaders/cursor_blaze.glsl


# Keybindings
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

keybind = super+n=new_window
keybind = super+v=paste_from_clipboard
keybind = super+shift+k=clear_screen

keybind = global:alt+shift+q=toggle_quick_terminal

# Tmux related Keybindings

# \x02 is ctrl+b (default tmux prefix)
# \x01 is ctrl+a (common alternative tmux prefix)
# \x00 is ctrl+space
# \x11 is ctrl+q

# tsm popup shrotcut toggle
keybind = ctrl+apostrophe=text:\x11'

# tmux navigation
keybind = ctrl+alt+p=text:\x11p
keybind = ctrl+alt+n=text:\x11n
keybind = ctrl+shift+tab=text:\x11p
keybind = ctrl+tab=text:\x11n
keybind = cmd+shift+left_bracket=text:\x11p
keybind = cmd+shift+right_bracket=text:\x11n
keybind = ctrl+alt+t=text:\x11T
keybind = ctrl+alt+r=text:\x11r

# Tabs manipulcation
keybind = cmd+t=text:\x11c
keybind = cmd+w=text:\x11&

# # Panel navigation
keybind = ctrl+shift+left=text:\x11h
keybind = ctrl+shift+right=text:\x11l
keybind = ctrl+shift+up=text:\x11k
keybind = ctrl+shift+down=text:\x11j

# other tmux goods

# copy mode
keybind = ctrl+alt+left_bracket=text:\x11[
# clear history
keybind = ctrl+alt+k=text:\x11\x1bl
# split
keybind = ctrl+alt+apostrophe=text:\x11"
# vertical split
keybind = ctrl+alt+slash=text:\x11|
# toggle zoom
keybind = ctrl+alt+z=text:\x11z
# command palette
keybind = cmd+p=text:\x11?

# tmux panel jump
keybind = cmd+Digit1=text:\x111
keybind = cmd+Digit2=text:\x112
keybind = cmd+Digit3=text:\x113
keybind = cmd+Digit4=text:\x114
keybind = cmd+Digit5=text:\x115
keybind = cmd+Digit6=text:\x116
keybind = cmd+Digit7=text:\x117
keybind = cmd+Digit8=text:\x118
keybind = cmd+Digit9=text:\x1b[F

# regular tmux panel jump (combine with remote session with default prefix)
keybind = ctrl+alt+Digit0=text:\x020
keybind = ctrl+alt+Digit1=text:\x021
keybind = ctrl+alt+Digit2=text:\x022
keybind = ctrl+alt+Digit3=text:\x023
keybind = ctrl+alt+Digit4=text:\x024
keybind = ctrl+alt+Digit5=text:\x025
keybind = ctrl+alt+Digit6=text:\x026
keybind = ctrl+alt+Digit7=text:\x027
keybind = ctrl+alt+Digit8=text:\x028
keybind = ctrl+alt+Digit9=text:\x029

keybind = ctrl+alt+left=text:\x02p
keybind = ctrl+alt+right=text:\x02n
