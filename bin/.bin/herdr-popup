#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF' >&2
Usage:
  herdr-popup [options] [--] [command [args...]]

Open a command in a native Herdr popup. With no command, open a login shell.

Options:
  -c, --cwd DIR       Working directory. Default: current directory
  -w, --width SIZE    Popup width in cells or percent. Default: 80%
  -H, --height SIZE   Popup height in cells or percent. Default: 80%
  -e, --env KEY=VALUE Add an environment variable to the popup process
  -h, --help          Show this help

Examples:
  herdr-popup
  herdr-popup lazygit
  herdr-popup -- rg TODO
  herdr-popup --cwd /tmp --env FOO=bar -- bash -lc 'printf "%s\n" "$FOO"'
EOF
}

die() {
  printf 'herdr-popup: %s\n' "$*" >&2
  exit 1
}

cwd="$PWD"
width="80%"
height="80%"
extra_env=()
extra_env_count=0

while [ "$#" -gt 0 ]; do
  case "$1" in
  -c | --cwd)
    [ "$#" -ge 2 ] || die "$1 requires an argument"
    cwd="$2"
    shift 2
    ;;
  -w | --width)
    [ "$#" -ge 2 ] || die "$1 requires an argument"
    width="$2"
    shift 2
    ;;
  -H | --height)
    [ "$#" -ge 2 ] || die "$1 requires an argument"
    height="$2"
    shift 2
    ;;
  -e | --env)
    [ "$#" -ge 2 ] || die "$1 requires an argument"
    case "$2" in
    *=*)
      extra_env[$extra_env_count]="$2"
      extra_env_count=$((extra_env_count + 1))
      ;;
    *) die "$1 requires KEY=VALUE" ;;
    esac
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  -*)
    die "unknown option: $1"
    ;;
  *)
    break
    ;;
  esac
done

command -v herdr >/dev/null 2>&1 || die "herdr not found in PATH"

herdr_args=(
  plugin pane open
  --plugin kakoune-popup
  --entrypoint command
  --placement popup
  --width "$width"
  --height "$height"
  --cwd "$cwd"
)

index=0
while [ "$index" -lt "$extra_env_count" ]; do
  herdr_args+=(--env "${extra_env[$index]}")
  index=$((index + 1))
done

herdr_args+=(--env "KAKOUNE_POPUP_ARGC=$#")
index=0
for arg; do
  herdr_args+=(--env "KAKOUNE_POPUP_ARG_$index=$arg")
  index=$((index + 1))
done

exec herdr "${herdr_args[@]}"
