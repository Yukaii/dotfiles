#!/bin/bash
set -e

# The name for the Docker image
IMAGE_NAME="tailscale-dev-env"
PROG=$(basename "$0")

# --- SUBCOMMANDS ---

build_image() {
  CUSTOM_IMAGE_NAME=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --image-name)
        CUSTOM_IMAGE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'build': $1" >&2
        echo "Usage: ${PROG} build [--image-name <custom-name>]" >&2
        exit 1
        ;;
    esac
  done

  # Use custom image name if provided, otherwise use default
  BUILD_IMAGE_NAME="${CUSTOM_IMAGE_NAME:-$IMAGE_NAME}"

  echo "Building Docker image: ${BUILD_IMAGE_NAME}..."
  # Use a heredoc to pass the Dockerfile to docker build.
  # This makes the script self-contained, with no external Dockerfile needed.
  docker build -t "${BUILD_IMAGE_NAME}" - <<'DOCKERFILE_EOF'
# Start from a base image
FROM debian:12-slim

# Install dependencies. No sshd on purpose: anything listening here is reachable
# from the whole tailnet. Use `ts-env shell` for a shell inside the container.
RUN apt-get update && apt-get install -y curl gnupg openssh-client net-tools iproute2 iputils-ping vim locales && rm -rf /var/lib/apt/lists/*

# Configure UTF-8 locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV TERM=xterm-256color

# Install Tailscale
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null && \
    curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list | tee /etc/apt/sources.list.d/tailscale.list && \
    apt-get update && \
    apt-get install -y tailscale && \
    rm -rf /var/lib/apt/lists/*

  # Create the startup script directly in the image using a portable printf.
  # This avoids needing a separate start.sh file.
  RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      '' \
      'TAILSCALE_STATE_DIR=/var/lib/tailscale/tailscaled.state' \
      'TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock' \
      '' \
      'cleanup() {' \
      '  if [ -n "${TAILSCALED_PID:-}" ]; then' \
      '    kill "${TAILSCALED_PID}" 2>/dev/null || true' \
      '  fi' \
      '}' \
      'trap cleanup INT TERM' \
      '' \
      'start_tailscaled() {' \
      '  mkdir -p /var/run/tailscale' \
      '  echo "Starting Tailscale daemon..."' \
      '  # Built-in proxies let the host reach this tailnet without an SSH tunnel.' \
      '  # Bind to eth0 only (where docker -p forwards to): on 0.0.0.0 they would' \
      '  # also be an open proxy for every peer on the tailnet. Fail closed.' \
      '  BIND_ADDR=$(ip -4 -o addr show dev eth0 2>/dev/null | sed -n "s/.*inet \([0-9.]*\).*/\1/p" | head -n1)' \
      '  if [ -z "${BIND_ADDR}" ]; then' \
      '    echo "No eth0 IPv4 address; proxies bound to 127.0.0.1 (unreachable from host)."' \
      '    BIND_ADDR=127.0.0.1' \
      '  fi' \
      '  tailscaled --state="${TAILSCALE_STATE_DIR}" --socket="${TAILSCALE_SOCKET}" \' \
      '    --socks5-server="${BIND_ADDR}:1080" --outbound-http-proxy-listen="${BIND_ADDR}:1081" &' \
      '  TAILSCALED_PID=$!' \
      '}' \
      '' \
      'tailscale_up() {' \
      '  HOSTNAME=${TAILSCALE_HOSTNAME:-my-dev-container}' \
      '  echo "Connecting to Tailscale network as ${HOSTNAME}..."' \
      '  TAILSCALE_FLAGS="--hostname=${HOSTNAME}"' \
      '  if [ -n "${TAILSCALE_AUTH_KEY:-}" ]; then' \
      '    TAILSCALE_FLAGS="${TAILSCALE_FLAGS} --auth-key=${TAILSCALE_AUTH_KEY}"' \
      '    echo "Using auth key for authentication"' \
      '  fi' \
      '  tailscale up ${TAILSCALE_FLAGS} ${TAILSCALE_EXTRA_ARGS:-}' \
      '}' \
      '' \
      'start_tailscaled' \
      'sleep 2' \
      '' \
      '# Initial connect attempt. If this fails (e.g. needs interactive login), keep container alive.' \
      'if ! tailscale_up 2>&1; then' \
      '  echo "Tailscale up failed (possibly needs login URL). Check logs and run tailscale up in container."' \
      'fi' \
      '' \
      'echo "Container is ready. Supervising tailscaled connectivity..."' \
      '' \
      'while true; do' \
      '  if ! kill -0 "${TAILSCALED_PID}" 2>/dev/null; then' \
      '    echo "tailscaled exited; restarting..."' \
      '    start_tailscaled' \
      '    sleep 2' \
      '  fi' \
      '' \
      '  if ! tailscale status >/dev/null 2>&1; then' \
      '    STATUS=$(tailscale status 2>&1 || true)' \
      '    echo "Tailscale unhealthy: ${STATUS}"' \
      '    if echo "${STATUS}" | grep -qi "logged out"; then' \
      '      echo "Tailscale is logged out; waiting for manual auth (or provide TAILSCALE_AUTH_KEY)."' \
      '      sleep 30' \
      '      continue' \
      '    fi' \
      '    tailscale_up >/dev/null 2>&1 || true' \
      '    sleep 10' \
      '    continue' \
      '  fi' \
      '' \
      'sleep 10' \
      'done' \
      > /start.sh

# Make the startup script executable
RUN chmod +x /start.sh

# Set the startup script as the entrypoint
ENTRYPOINT ["/start.sh"]
DOCKERFILE_EOF
  echo "Build complete."
}

run_container() {
  UNIQUE_NAME=""
  DATA_DIR_BASE=""
  CUSTOM_IMAGE_NAME=""
  SOCKS5_PORT=""
  HTTP_PORT=""
  AUTH_KEY=""
  TS_ARGS=""
  MOUNT_SSH="false"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      --mount-ssh)
        MOUNT_SSH="true"
        shift
        ;;
      --data-dir)
        DATA_DIR_BASE="$2"
        shift 2
        ;;
      --image-name)
        CUSTOM_IMAGE_NAME="$2"
        shift 2
        ;;
      --socks5-port)
        SOCKS5_PORT="$2"
        shift 2
        ;;
      --http-port)
        HTTP_PORT="$2"
        shift 2
        ;;
      --auth-key)
        AUTH_KEY="$2"
        shift 2
        ;;
      --ts-args)
        TS_ARGS="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'run': $1" >&2
        echo "Usage: ${PROG} run --name <unique-name> [--data-dir <path>] [--image-name <custom-name>] [--socks5-port <port>] [--http-port <port>] [--auth-key <key>] [--ts-args '<tailscale up flags>'] [--mount-ssh]" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'run' command requires a --name." >&2
    echo "Usage: ${PROG} run --name <unique-name>" >&2
    exit 1
  fi

  if [ -z "$DATA_DIR_BASE" ]; then
    # Use XDG_CONFIG_HOME if set, otherwise default to ~/.config
    XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
    DATA_DIR_BASE="${XDG_CONFIG_HOME}/ts-env"
  fi

  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  DATA_DIR="${DATA_DIR_BASE}/${UNIQUE_NAME}"
  HOSTNAME=${CONTAINER_NAME}

  mkdir -p "${DATA_DIR}"

  # Use custom image name if provided, otherwise use default
  RUN_IMAGE_NAME="${CUSTOM_IMAGE_NAME:-$IMAGE_NAME}"

  # Publish tailscaled's built-in proxies on localhost only (never the LAN)
  DOCKER_ARGS=()
  if [ -n "$SOCKS5_PORT" ]; then
    DOCKER_ARGS+=(-p "127.0.0.1:${SOCKS5_PORT}:1080")
  fi
  if [ -n "$HTTP_PORT" ]; then
    DOCKER_ARGS+=(-p "127.0.0.1:${HTTP_PORT}:1081")
  fi

  DOCKER_ARGS+=(-e "TAILSCALE_HOSTNAME=${HOSTNAME}")
  if [ -n "$AUTH_KEY" ]; then
    DOCKER_ARGS+=(-e "TAILSCALE_AUTH_KEY=${AUTH_KEY}")
  fi
  if [ -n "$TS_ARGS" ]; then
    DOCKER_ARGS+=(-e "TAILSCALE_EXTRA_ARGS=${TS_ARGS}")
  fi
  # Opt-in: only needed to ssh from *inside* the container (ts-env shell).
  if [ "$MOUNT_SSH" = "true" ]; then
    DOCKER_ARGS+=(-v "${HOME}/.ssh:/root/.ssh:ro")
  fi

  echo "Starting container ${CONTAINER_NAME}..."
  docker run -d --restart=unless-stopped --name="${CONTAINER_NAME}" \
        --hostname="${HOSTNAME}" \
        --device=/dev/net/tun \
        --cap-add=NET_ADMIN \
        -v "${DATA_DIR}":/var/lib/tailscale \
        "${DOCKER_ARGS[@]}" \
        "${RUN_IMAGE_NAME}"

  echo "Container ${CONTAINER_NAME} started with auto-restart policy."
  if [ -n "$SOCKS5_PORT" ]; then
    echo "SOCKS5 proxy will be available on 127.0.0.1:${SOCKS5_PORT} once connected"
  fi
  if [ -n "$HTTP_PORT" ]; then
    echo "HTTP proxy will be available on 127.0.0.1:${HTTP_PORT} once connected"
  fi
  echo "To get the auth URL, run: ${PROG} login --name ${UNIQUE_NAME}"
}

show_logs() {
  UNIQUE_NAME=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'logs': $1" >&2
        echo "Usage: ${PROG} logs --name <unique-name>" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'logs' command requires a --name." >&2
    echo "Usage: ${PROG} logs --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  docker logs -f "${CONTAINER_NAME}"
}

open_shell() {
  UNIQUE_NAME=""
  SHELL_COMMAND="/bin/bash"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      --command)
        SHELL_COMMAND="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'shell': $1" >&2
        echo "Usage: ${PROG} shell --name <name> [--command 'custom command']" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'shell' command requires a --name." >&2
    echo "Usage: ${PROG} shell --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"

  if [ "${SHELL_COMMAND}" = "/bin/bash" ]; then
    docker exec --detach-keys="ctrl-]" -it "${CONTAINER_NAME}" /bin/bash
  else
    # Use `sh -c` to handle commands with arguments correctly.
    docker exec --detach-keys="ctrl-]" -it "${CONTAINER_NAME}" sh -c "${SHELL_COMMAND}"
  fi
}

list_containers() {
  echo "Listing running Tailscale containers..."
  docker ps --filter "name=multi-ts-" --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' | sed 's/^multi-ts-//'
}

stop_container() {
  UNIQUE_NAME=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'stop': $1" >&2
        echo "Usage: ${PROG} stop --name <unique-name>" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'stop' command requires a --name." >&2
    echo "Usage: ${PROG} stop --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  echo "Stopping and removing container ${CONTAINER_NAME}..."
  docker stop "${CONTAINER_NAME}"
  docker rm "${CONTAINER_NAME}"
}

wipe_data() {
    UNIQUE_NAME=""
    DATA_DIR_BASE=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --data-dir)
                DATA_DIR_BASE="$2"
                shift 2
                ;;
            *)
                echo "Unknown option for 'wipe': $1" >&2
                echo "Usage: ${PROG} wipe --name <unique-name> [--data-dir <path>]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'wipe' command requires a --name." >&2
        echo "Usage: ${PROG} wipe --name <unique-name>" >&2
        exit 1
    fi

    if [ -z "$DATA_DIR_BASE" ]; then
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
        DATA_DIR_BASE="${XDG_CONFIG_HOME}/ts-env"
    fi

    DATA_DIR="${DATA_DIR_BASE}/${UNIQUE_NAME}"

    if [ -d "${DATA_DIR}" ]; then
        echo "Are you sure you want to delete ${DATA_DIR}? [y/N]"
        read -r confirmation
        if [ "$confirmation" = "y" ] || [ "$confirmation" = "Y" ]; then
            echo "Wiping data directory: ${DATA_DIR}"
            rm -rf "${DATA_DIR}"
            echo "Data wiped."
        else
            echo "Wipe cancelled."
        fi
    else
        echo "Data directory not found: ${DATA_DIR}"
    fi
}

debug_container() {
    parse_name_and_rest "$@"

    echo "=== Container Debug Information ==="
    echo "Container name: ${CONTAINER_NAME}"
    echo ""

    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "❌ Container is not running"
        echo "Available containers:"
        docker ps --filter "name=multi-ts-" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        return 1
    fi
    echo "✅ Container is running"

    echo ""
    echo "=== Published proxies ==="
    echo "SOCKS5: $(published_addr 1080 || true)"
    echo "HTTP:   $(published_addr 1081 || true)"

    echo ""
    echo "=== Listening sockets ==="
    docker exec "${CONTAINER_NAME}" netstat -tlnp || true

    echo ""
    echo "=== Tailscale Status ==="
    docker exec "${CONTAINER_NAME}" tailscale status || echo "Tailscale not connected"
}

tailscale_reconnect() {
    UNIQUE_NAME=""
    AUTH_KEY=""
    RESET="false"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --auth-key)
                AUTH_KEY="$2"
                shift 2
                ;;
            --reset)
                RESET="true"
                shift
                ;;
            *)
                echo "Unknown option for 'reconnect': $1" >&2
                echo "Usage: ${PROG} reconnect --name <unique-name> [--auth-key <key>] [--reset]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'reconnect' command requires a --name." >&2
        echo "Usage: ${PROG} reconnect --name <unique-name>" >&2
        exit 1
    fi

    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"

    RESET_FLAG=""
    if [ "$RESET" = "true" ]; then
        RESET_FLAG="--reset"
    fi

    echo "Reconnecting Tailscale inside ${CONTAINER_NAME}..."
    # Reuse the hostname/flags the container was started with: `tailscale up`
    # rejects (or with --reset, silently drops) previously-set flags otherwise.
    # The auth key goes in via env so it never appears in output or `ps`.
    docker exec -it -e "TS_RECONNECT_KEY=${AUTH_KEY}" "${CONTAINER_NAME}" sh -c \
        'tailscale up --hostname="${TAILSCALE_HOSTNAME}" ${TAILSCALE_EXTRA_ARGS:-} ${TS_RECONNECT_KEY:+--auth-key="${TS_RECONNECT_KEY}"} '"${RESET_FLAG}"
}

# Resolve "--name <name>" for the proxy helpers; remaining args land in REST_ARGS.
parse_name_and_rest() {
    UNIQUE_NAME=""
    REST_ARGS=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --)
                shift
                REST_ARGS+=("$@")
                break
                ;;
            *)
                REST_ARGS+=("$1")
                shift
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: '${COMMAND}' command requires a --name." >&2
        echo "Usage: ${PROG} ${COMMAND} --name <unique-name> [args...]" >&2
        exit 1
    fi
    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
}

# Host address of a published container port, e.g. "127.0.0.1:1080".
published_addr() {
    docker port "${CONTAINER_NAME}" "$1/tcp" 2>/dev/null | head -n1
}

require_socks() {
    SOCKS_ADDR=$(published_addr 1080)
    if [ -z "$SOCKS_ADDR" ]; then
        echo "Error: ${CONTAINER_NAME} has no SOCKS5 port published." >&2
        echo "Recreate it with: ${PROG} stop --name ${UNIQUE_NAME} && ${PROG} run --name ${UNIQUE_NAME} --socks5-port <port>" >&2
        exit 1
    fi
}

show_status() {
    parse_name_and_rest "$@"
    docker exec "${CONTAINER_NAME}" tailscale status "${REST_ARGS[@]}"
}

show_login() {
    parse_name_and_rest "$@"
    # `tailscale status` prints "Log in at: <url>" while logged out.
    STATUS=$(docker exec "${CONTAINER_NAME}" tailscale status 2>&1 || true)
    URL=$(echo "${STATUS}" | grep -oE 'https://login\.tailscale\.com/[A-Za-z0-9/]+' | head -n1)
    if [ -n "$URL" ]; then
        echo "Open this URL and sign in to the target tailnet:"
        echo "  ${URL}"
    elif echo "${STATUS}" | grep -qi "logged out"; then
        echo "Logged out but no URL yet; run: ${PROG} reconnect --name ${UNIQUE_NAME}"
    else
        echo "Already logged in:"
        echo "${STATUS}" | head -n1
    fi
}

print_env() {
    parse_name_and_rest "$@"
    require_socks
    HTTP_ADDR=$(published_addr 1081)
    echo "# eval \"\$(${PROG} env --name ${UNIQUE_NAME})\""
    echo "export ALL_PROXY=socks5h://${SOCKS_ADDR}"
    if [ -n "$HTTP_ADDR" ]; then
        echo "export HTTP_PROXY=http://${HTTP_ADDR} HTTPS_PROXY=http://${HTTP_ADDR}"
    fi
}

ssh_via() {
    parse_name_and_rest "$@"
    require_socks
    exec ssh -o ProxyCommand="nc -X 5 -x ${SOCKS_ADDR} %h %p" "${REST_ARGS[@]}"
}

print_ssh_config() {
    parse_name_and_rest "$@"
    require_socks
    SUFFIX=$(docker exec "${CONTAINER_NAME}" tailscale status --json 2>/dev/null \
        | sed -n 's/.*"MagicDNSSuffix": *"\([^"]*\)".*/\1/p' | head -n1)
    if [ -z "$SUFFIX" ]; then
        echo "Error: no MagicDNS suffix yet; is ${CONTAINER_NAME} logged in? (${PROG} login --name ${UNIQUE_NAME})" >&2
        exit 1
    fi
    echo "# ${UNIQUE_NAME} tailnet via ts-env (append to ~/.ssh/config)"
    echo "Host *.${SUFFIX}"
    echo "  ProxyCommand nc -X 5 -x ${SOCKS_ADDR} %h %p"
}

curl_via() {
    parse_name_and_rest "$@"
    require_socks
    # socks5h: tailscaled resolves MagicDNS names for this tailnet.
    exec curl --proxy "socks5h://${SOCKS_ADDR}" "${REST_ARGS[@]}"
}

# --- MAIN LOGIC ---

COMMAND=$1
shift || true # Shift arguments to the left, ignore error if no args

case "$COMMAND" in
  build)
    build_image "$@"
    ;;
  run)
    run_container "$@"
    ;;
  logs)
    show_logs "$@"
    ;;
  shell)
    open_shell "$@"
    ;;
  list)
    list_containers
    ;;
  stop)
    stop_container "$@"
    ;;
  wipe)
    wipe_data "$@"
    ;;
  debug)
    debug_container "$@"
    ;;
  status)
    show_status "$@"
    ;;
  login)
    show_login "$@"
    ;;
  env|proxy)
    print_env "$@"
    ;;
  ssh)
    ssh_via "$@"
    ;;
  ssh-config)
    print_ssh_config "$@"
    ;;
  curl)
    curl_via "$@"
    ;;
  reconnect)
    tailscale_reconnect "$@"
    ;;
  *)
    cat >&2 <<HELP_EOF
Tailscale Development Environment Manager

Runs extra tailnets in containers, each with its own tailscaled, so the host's
Tailscale connection stays untouched. tailscaled's built-in SOCKS5/HTTP proxies
are published on 127.0.0.1 for host apps.

REQUIREMENTS:
  - Docker daemon must be running (OrbStack / Docker Desktop / Docker Engine)
  - For 'ssh' / 'ssh-config': an nc with SOCKS5 support (-X 5). Built in on
    macOS; on Linux install netcat-openbsd.

FIRST TIME SETUP:
  1. Build the image: ${PROG} build
  2. Run a container: ${PROG} run --name work --socks5-port 1080
  3. Log in:          ${PROG} login --name work

Usage: ${PROG} {build|run|login|status|env|ssh|ssh-config|curl|logs|shell|list|stop|wipe|debug|reconnect} [options]

Commands:
  build [--image-name <name>]
                             Build the Docker image (rebuild to update Tailscale).

  run --name <name> [--socks5-port <port>] [--http-port <port>] [--auth-key <key>]
      [--ts-args '<flags>'] [--mount-ssh] [--data-dir <path>] [--image-name <name>]
                             Run a new container. Ports bind to 127.0.0.1 only.
                             --ts-args is passed to 'tailscale up' (e.g. '--accept-routes').
                             --mount-ssh mounts ~/.ssh read-only (for ssh from 'shell').
                             Note: --auth-key is visible in 'docker inspect'.

  login --name <name>        Print the login URL (or current login state).
  status --name <name> [args...]
                             Run 'tailscale status' inside the container.

  env --name <name>          Print ALL_PROXY / HTTP(S)_PROXY exports for the container.
                             Usage: eval "\$(${PROG} env --name work)"
  ssh --name <name> [ssh args...]
                             SSH to a host on that tailnet (MagicDNS names work).
  ssh-config --name <name>   Print a ~/.ssh/config block routing *.<tailnet>.ts.net
                             through this container.
  curl --name <name> [curl args...]
                             curl through that tailnet.

  logs --name <name>         Follow the container logs.
  shell --name <name> [--command 'cmd']
                             Interactive shell (or command) inside the container.
  list                       List running containers with ports.
  stop --name <name>         Stop and remove a container (state is kept).
  wipe --name <name> [--data-dir <path>]
                             Delete a container's saved Tailscale state.
  debug --name <name>        Print diagnostics.
  reconnect --name <name> [--auth-key <key>] [--reset]
                             Re-run 'tailscale up' inside the container.

EXAMPLES:
  ${PROG} run --name work --socks5-port 1080 --http-port 1081 --ts-args '--accept-routes'
  ${PROG} login --name work
  ${PROG} ssh --name work me@devbox
  ${PROG} ssh-config --name work >> ~/.ssh/config
  ${PROG} curl --name work http://grafana:3000
  eval "\$(${PROG} env --name work)"; gh api ...
HELP_EOF
    exit 1
    ;;
esac
