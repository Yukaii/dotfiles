#!/bin/bash
set -e

# The name for the Docker image
IMAGE_NAME="tailscale-dev-env"

# --- SUBCOMMANDS ---

build_image() {
  CUSTOM_IMAGE_NAME=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --image-name)
        CUSTOM_IMAGE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'build': $1" >&2
        echo "Usage: $0 build [--image-name <custom-name>]" >&2
        exit 1
        ;;
    esac
  done

  # Use custom image name if provided, otherwise use default
  BUILD_IMAGE_NAME="${CUSTOM_IMAGE_NAME:-$IMAGE_NAME}"

  echo "Building Docker image: ${BUILD_IMAGE_NAME}..."
  # Use a heredoc to pass the Dockerfile to docker build.
  # This makes the script self-contained, with no external Dockerfile needed.
  docker build -t "${BUILD_IMAGE_NAME}" - <<'DOCKERFILE_EOF'
# Start from a base image
FROM debian:12-slim

# Install dependencies, including ping, vim, mosh, openssh-server, net-tools, and locale support
RUN apt-get update && apt-get install -y curl gnupg ssh openssh-server net-tools iputils-ping vim mosh locales && rm -rf /var/lib/apt/lists/*

# Configure SSH
RUN mkdir -p /var/run/sshd /root/.ssh_writable && \
    echo 'root:tailscale' | chpasswd && \
    sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    sed -i 's/#Port 22/Port 22/' /etc/ssh/sshd_config && \
    sed -i 's/#ListenAddress 0.0.0.0/ListenAddress 0.0.0.0/' /etc/ssh/sshd_config && \
    sed -i 's|#AuthorizedKeysFile.*|AuthorizedKeysFile /root/.ssh_writable/authorized_keys|' /etc/ssh/sshd_config && \
    ssh-keygen -A

# Configure UTF-8 locale for mosh
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV TERM=xterm-256color

# Install Tailscale
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg | tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null && \
    curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list | tee /etc/apt/sources.list.d/tailscale.list && \
    apt-get update && \
    apt-get install -y tailscale && \
    rm -rf /var/lib/apt/lists/*

  # Create the startup script directly in the image using a portable printf.
  # This avoids needing a separate start.sh file.
  RUN printf '%s\n' \
      '#!/bin/sh' \
      'set -eu' \
      '' \
      'TAILSCALE_STATE_DIR=/var/lib/tailscale/tailscaled.state' \
      'TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock' \
      '' \
      'cleanup() {' \
      '  if [ -n "${TAILSCALED_PID:-}" ]; then' \
      '    kill "${TAILSCALED_PID}" 2>/dev/null || true' \
      '  fi' \
      '}' \
      'trap cleanup INT TERM' \
      '' \
      'echo "Starting SSH server..."' \
      'service ssh start || true' \
      'sleep 1' \
      'service ssh status || true' \
      'netstat -tlnp | grep :22 >/dev/null 2>&1 || echo "SSH not listening on port 22"' \
      '' \
      'start_tailscaled() {' \
      '  mkdir -p /var/run/tailscale' \
      '  echo "Starting Tailscale daemon..."' \
      '  tailscaled --state="${TAILSCALE_STATE_DIR}" --socket="${TAILSCALE_SOCKET}" &' \
      '  TAILSCALED_PID=$!' \
      '}' \
      '' \
      'tailscale_up() {' \
      '  HOSTNAME=${TAILSCALE_HOSTNAME:-my-dev-container}' \
      '  echo "Connecting to Tailscale network as ${HOSTNAME}..."' \
      '  TAILSCALE_FLAGS="--hostname=${HOSTNAME}"' \
      '  if [ -n "${TAILSCALE_AUTH_KEY:-}" ]; then' \
      '    TAILSCALE_FLAGS="${TAILSCALE_FLAGS} --auth-key=${TAILSCALE_AUTH_KEY}"' \
      '    echo "Using auth key for authentication"' \
      '  fi' \
      '  tailscale up ${TAILSCALE_FLAGS}' \
      '}' \
      '' \
      'start_tailscaled' \
      'sleep 2' \
      '' \
      '# Initial connect attempt. If this fails (e.g. needs interactive login), keep container alive.' \
      'if ! tailscale_up 2>&1; then' \
      '  echo "Tailscale up failed (possibly needs login URL). Check logs and run tailscale up in container."' \
      'fi' \
      '' \
      'echo "Container is ready. Supervising tailscaled connectivity..."' \
      'echo "SSH root password: tailscale"' \
      '' \
      'while true; do' \
      '  if ! kill -0 "${TAILSCALED_PID}" 2>/dev/null; then' \
      '    echo "tailscaled exited; restarting..."' \
      '    start_tailscaled' \
      '    sleep 2' \
      '  fi' \
      '' \
      '  if ! tailscale status >/dev/null 2>&1; then' \
      '    STATUS=$(tailscale status 2>&1 || true)' \
      '    echo "Tailscale unhealthy: ${STATUS}"' \
      '    if echo "${STATUS}" | grep -qi "logged out"; then' \
      '      echo "Tailscale is logged out; waiting for manual auth (or provide TAILSCALE_AUTH_KEY)."' \
      '      sleep 30' \
      '      continue' \
      '    fi' \
      '    tailscale_up >/dev/null 2>&1 || true' \
      '    sleep 10' \
      '    continue' \
      '  fi' \
      '' \
      'sleep 10' \
      'done' \
      > /start.sh

# Make the startup script executable
RUN chmod +x /start.sh

# Set the startup script as the entrypoint
ENTRYPOINT ["/start.sh"]
DOCKERFILE_EOF
  echo "Build complete."
}

run_container() {
  UNIQUE_NAME=""
  DATA_DIR_BASE=""
  CUSTOM_IMAGE_NAME=""
  SOCKS5_PORT=""
  AUTH_KEY=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      --data-dir)
        DATA_DIR_BASE="$2"
        shift 2
        ;;
      --image-name)
        CUSTOM_IMAGE_NAME="$2"
        shift 2
        ;;
      --socks5-port)
        SOCKS5_PORT="$2"
        shift 2
        ;;
      --auth-key)
        AUTH_KEY="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'run': $1" >&2
        echo "Usage: $0 run --name <unique-name> [--data-dir <path>] [--image-name <custom-name>] [--socks5-port <port>] [--auth-key <key>]" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'run' command requires a --name." >&2
    echo "Usage: $0 run --name <unique-name>" >&2
    exit 1
  fi

  if [ -z "$DATA_DIR_BASE" ]; then
    # Use XDG_CONFIG_HOME if set, otherwise default to ~/.config
    XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
    DATA_DIR_BASE="${XDG_CONFIG_HOME}/ts-env"
  fi

  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  DATA_DIR="${DATA_DIR_BASE}/${UNIQUE_NAME}"
  HOSTNAME=${CONTAINER_NAME}

  mkdir -p "${DATA_DIR}"

  # Use custom image name if provided, otherwise use default
  RUN_IMAGE_NAME="${CUSTOM_IMAGE_NAME:-$IMAGE_NAME}"

  # Build Docker run command with optional SOCKS5 port mapping
  DOCKER_PORTS=""
  if [ -n "$SOCKS5_PORT" ]; then
    DOCKER_PORTS="-p ${SOCKS5_PORT}:1080"
  fi

  # Build environment variables
  DOCKER_ENV="-e TAILSCALE_HOSTNAME=${HOSTNAME}"
  if [ -n "$AUTH_KEY" ]; then
    DOCKER_ENV="${DOCKER_ENV} -e TAILSCALE_AUTH_KEY=${AUTH_KEY}"
  fi

  echo "Starting container ${CONTAINER_NAME}..."
  docker run -d --restart=unless-stopped --name="${CONTAINER_NAME}" \
        --hostname="${HOSTNAME}" \
        --device=/dev/net/tun \
        --cap-add=NET_ADMIN \
        -v "${DATA_DIR}":/var/lib/tailscale \
        -v ~/.ssh:/root/.ssh:ro \
        ${DOCKER_ENV} \
        ${DOCKER_PORTS} \
        "${RUN_IMAGE_NAME}"

  echo "Container ${CONTAINER_NAME} started with auto-restart policy."
  if [ -n "$SOCKS5_PORT" ]; then
    echo "SOCKS5 proxy will be available on localhost:${SOCKS5_PORT} once connected"
  fi
  echo "To get the auth URL, run: $0 logs --name ${UNIQUE_NAME}"
}

show_logs() {
  UNIQUE_NAME=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'logs': $1" >&2
        echo "Usage: $0 logs --name <unique-name>" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'logs' command requires a --name." >&2
    echo "Usage: $0 logs --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  docker logs -f "${CONTAINER_NAME}"
}

open_shell() {
  UNIQUE_NAME=""
  SHELL_COMMAND="/bin/bash"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      --command)
        SHELL_COMMAND="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'shell': $1" >&2
        echo "Usage: $0 shell --name <name> [--command 'custom command']" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'shell' command requires a --name." >&2
    echo "Usage: $0 shell --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  # Use `sh -c` to handle commands with arguments correctly.
  docker exec -it "${CONTAINER_NAME}" sh -c "${SHELL_COMMAND}"
}

list_containers() {
  echo "Listing running Tailscale containers..."
  docker ps --filter "name=multi-ts-*" --format '{{json .}}' | jq -r '.Names | sub("multi-ts-"; "")'
}

stop_container() {
  UNIQUE_NAME=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name)
        UNIQUE_NAME="$2"
        shift 2
        ;;
      *)
        echo "Unknown option for 'stop': $1" >&2
        echo "Usage: $0 stop --name <unique-name>" >&2
        exit 1
        ;;
    esac
  done

  if [ -z "$UNIQUE_NAME" ]; then
    echo "Error: 'stop' command requires a --name." >&2
    echo "Usage: $0 stop --name <unique-name>" >&2
    exit 1
  fi
  CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
  echo "Stopping and removing container ${CONTAINER_NAME}..."
  docker stop "${CONTAINER_NAME}"
  docker rm "${CONTAINER_NAME}"
}

wipe_data() {
    UNIQUE_NAME=""
    DATA_DIR_BASE=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --data-dir)
                DATA_DIR_BASE="$2"
                shift 2
                ;;
            *)
                echo "Unknown option for 'wipe': $1" >&2
                echo "Usage: $0 wipe --name <unique-name> [--data-dir <path>]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'wipe' command requires a --name." >&2
        echo "Usage: $0 wipe --name <unique-name>" >&2
        exit 1
    fi

    if [ -z "$DATA_DIR_BASE" ]; then
        XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
        DATA_DIR_BASE="${XDG_CONFIG_HOME}/ts-env"
    fi

    DATA_DIR="${DATA_DIR_BASE}/${UNIQUE_NAME}"

    if [ -d "${DATA_DIR}" ]; then
        echo "Are you sure you want to delete ${DATA_DIR}? [y/N]"
        read -r confirmation
        if [ "$confirmation" = "y" ] || [ "$confirmation" = "Y" ]; then
            echo "Wiping data directory: ${DATA_DIR}"
            rm -rf "${DATA_DIR}"
            echo "Data wiped."
        else
            echo "Wipe cancelled."
        fi
    else
        echo "Data directory not found: ${DATA_DIR}"
    fi
}

debug_container() {
    UNIQUE_NAME=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            *)
                echo "Unknown option for 'debug': $1" >&2
                echo "Usage: $0 debug --name <unique-name>" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'debug' command requires a --name." >&2
        echo "Usage: $0 debug --name <unique-name>" >&2
        exit 1
    fi

    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"

    echo "=== Container Debug Information ==="
    echo "Container name: ${CONTAINER_NAME}"
    echo ""

    # Check if container exists and is running
    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "❌ Container is not running"
        echo "Available containers:"
        docker ps --filter "name=multi-ts-*" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        return 1
    fi

    echo "✅ Container is running"

    # Get container info
    CONTAINER_IP=$(docker inspect "${CONTAINER_NAME}" --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' 2>/dev/null || echo "")
    echo "Container IP: ${CONTAINER_IP}"

    # Check SSH server status
    echo ""
    echo "=== SSH Server Status ==="
    docker exec "${CONTAINER_NAME}" sh -c "ps aux | grep sshd | grep -v grep" || echo "SSH server not running"

    # Check if SSH port is listening
    echo ""
    echo "=== Network Status ==="
    docker exec "${CONTAINER_NAME}" sh -c "netstat -tlnp | grep :22" || echo "SSH port 22 not listening"

    # Test SSH connectivity
    echo ""
    echo "=== SSH Connectivity Test ==="
    if ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=3 \
       -o BatchMode=yes "root@${CONTAINER_IP}" "echo 'SSH working'" 2>/dev/null; then
        echo "✅ SSH connection successful"
    else
        echo "❌ SSH connection failed"
        echo "Try manual SSH: ssh root@${CONTAINER_IP} (password: tailscale)"
    fi

    # Check Tailscale status
    echo ""
    echo "=== Tailscale Status ==="
    docker exec "${CONTAINER_NAME}" tailscale status || echo "Tailscale not connected"
}

proxy_docker_command() {
    UNIQUE_NAME=""
    LOCAL_PORT="1080"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --port)
                LOCAL_PORT="$2"
                shift 2
                ;;
            *)
                echo "Unknown option for 'proxy-docker': $1" >&2
                echo "Usage: $0 proxy-docker --name <unique-name> [--port <local-port>]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'proxy-docker' command requires a --name." >&2
        echo "Usage: $0 proxy-docker --name <unique-name> [--port <local-port>]" >&2
        exit 1
    fi

    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"

    # Check if container was started with port mapping
    CONTAINER_PORTS=$(docker inspect "${CONTAINER_NAME}" --format '{{.NetworkSettings.Ports}}' 2>/dev/null || echo "")
    if echo "$CONTAINER_PORTS" | grep -q "${LOCAL_PORT}/tcp"; then
        echo "✓ Container has port mapping for ${LOCAL_PORT}"
        echo "Starting Docker-based SOCKS5 proxy on localhost:${LOCAL_PORT}..."
        echo "This approach uses Docker exec with port mapping"
        echo "Press Ctrl+C to stop the proxy"
        echo ""

        # Start SOCKS proxy using Docker exec with port mapping
        docker exec -it "${CONTAINER_NAME}" sh -c "
            echo 'Starting SOCKS5 proxy inside container on port ${LOCAL_PORT}...'

            # Create SSH keys in a writable location
            SSH_DIR='/tmp/.ssh'
            mkdir -p \$SSH_DIR
            chmod 700 \$SSH_DIR

            if [ ! -f \$SSH_DIR/id_ed25519 ]; then
                echo 'Creating SSH keys in writable location...'
                ssh-keygen -t ed25519 -f \$SSH_DIR/id_ed25519 -N \"\"
                cp \$SSH_DIR/id_ed25519.pub \$SSH_DIR/authorized_keys
                chmod 600 \$SSH_DIR/authorized_keys
            fi

            # Update SSH config to use our keys
            mkdir -p /root/.ssh_writable
            cp \$SSH_DIR/authorized_keys /root/.ssh_writable/
            chmod 600 /root/.ssh_writable/authorized_keys

            echo 'Starting SSH tunnel with key authentication...'
            ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                -o BatchMode=yes -i \$SSH_DIR/id_ed25519 \
                -N -D 0.0.0.0:${LOCAL_PORT} root@localhost &
            SSH_PID=\$!
            echo 'SOCKS5 proxy started with PID '\$SSH_PID
            echo 'Configure your applications to use SOCKS5 proxy: 127.0.0.1:${LOCAL_PORT}'
            trap 'kill \$SSH_PID 2>/dev/null || true; exit' INT TERM
            wait \$SSH_PID
        "
    else
        echo "❌ Container not started with port mapping for ${LOCAL_PORT}"
        echo "To use proxy-docker, restart container with port mapping:"
        echo "  $0 stop --name ${UNIQUE_NAME}"
        echo "  $0 run --name ${UNIQUE_NAME} --socks5-port ${LOCAL_PORT}"
        echo "  $0 proxy-docker --name ${UNIQUE_NAME}"
        echo ""
        echo "Or use the regular proxy command (external SSH):"
        echo "  $0 proxy --name ${UNIQUE_NAME}"
        exit 1
    fi
}

tailscale_reconnect() {
    UNIQUE_NAME=""
    AUTH_KEY=""
    RESET="false"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --auth-key)
                AUTH_KEY="$2"
                shift 2
                ;;
            --reset)
                RESET="true"
                shift
                ;;
            *)
                echo "Unknown option for 'reconnect': $1" >&2
                echo "Usage: $0 reconnect --name <unique-name> [--auth-key <key>] [--reset]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'reconnect' command requires a --name." >&2
        echo "Usage: $0 reconnect --name <unique-name>" >&2
        exit 1
    fi

    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"
    HOSTNAME="${CONTAINER_NAME}"

    AUTH_FLAG=""
    if [ -n "$AUTH_KEY" ]; then
        AUTH_FLAG="--auth-key=${AUTH_KEY}"
    fi

    RESET_FLAG=""
    if [ "$RESET" = "true" ]; then
        RESET_FLAG="--reset"
    fi

    echo "Reconnecting Tailscale inside ${CONTAINER_NAME}..."
    echo "Command: tailscale up --hostname=${HOSTNAME} ${AUTH_FLAG} ${RESET_FLAG}"

    # Use `sh -c` to keep arg handling simple and allow empty flags.
    docker exec -it "${CONTAINER_NAME}" sh -c "tailscale up --hostname='${HOSTNAME}' ${AUTH_FLAG} ${RESET_FLAG}"
}

proxy_command() {
    UNIQUE_NAME=""
    LOCAL_PORT="1080"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --name)
                UNIQUE_NAME="$2"
                shift 2
                ;;
            --port)
                LOCAL_PORT="$2"
                shift 2
                ;;
            *)
                echo "Unknown option for 'proxy': $1" >&2
                echo "Usage: $0 proxy --name <unique-name> [--port <local-port>]" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$UNIQUE_NAME" ]; then
        echo "Error: 'proxy' command requires a --name." >&2
        echo "Usage: $0 proxy --name <unique-name> [--port <local-port>]" >&2
        exit 1
    fi

    CONTAINER_NAME="multi-ts-${UNIQUE_NAME}"

    # Get container IP address
    CONTAINER_IP=$(docker inspect "${CONTAINER_NAME}" --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' 2>/dev/null || echo "")

    if [ -z "$CONTAINER_IP" ]; then
        echo "Error: Container ${CONTAINER_NAME} not found or not running" >&2
        exit 1
    fi

    # Check if SSH tunnel is already running
    if pgrep -f "ssh.*${CONTAINER_IP}.*-D ${LOCAL_PORT}" > /dev/null; then
        echo "SOCKS5 proxy is already running on localhost:${LOCAL_PORT}"
        echo "To stop it, run: pkill -f \"ssh.*${CONTAINER_IP}.*-D ${LOCAL_PORT}\""
        exit 1
    fi

    echo "Starting SOCKS5 proxy on localhost:${LOCAL_PORT} via SSH to container..."
    echo "Container IP: ${CONTAINER_IP}"
    echo ""
    echo "Testing SSH connectivity first..."

    # Test SSH connectivity first
    if ! ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o ConnectTimeout=5 \
         -o BatchMode=yes "root@${CONTAINER_IP}" "echo 'SSH connection successful'" 2>/dev/null; then
        echo "✗ SSH connection failed!"
        echo ""
        echo "Troubleshooting steps:"
        echo "1. Check if container is running: docker ps | grep ${CONTAINER_NAME}"
        echo "2. Check container logs: $0 logs --name ${UNIQUE_NAME}"
        echo "3. Test SSH manually: ssh root@${CONTAINER_IP} (password: tailscale)"
        echo "4. Check if SSH is running in container: $0 shell --name ${UNIQUE_NAME} --command 'ps aux | grep ssh'"
        echo "5. Rebuild image with SSH fixes: $0 build"
        exit 1
    fi

    echo "✓ SSH connection successful!"
    echo "Configure your applications to use SOCKS5 proxy: 127.0.0.1:${LOCAL_PORT}"
    echo "Press Ctrl+C to stop the proxy"
    echo ""

    # Start SSH SOCKS proxy (foreground, will run until interrupted)
    ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
        -N -D "${LOCAL_PORT}" "root@${CONTAINER_IP}"
}

# --- MAIN LOGIC ---

COMMAND=$1
shift || true # Shift arguments to the left, ignore error if no args

case "$COMMAND" in
  build)
    build_image "$@"
    ;;
  run)
    run_container "$@"
    ;;
  logs)
    show_logs "$@"
    ;;
  shell)
    open_shell "$@"
    ;;
  list)
    list_containers
    ;;
  stop)
    stop_container "$@"
    ;;
  wipe)
    wipe_data "$@"
    ;;
  debug)
    debug_container "$@"
    ;;
  proxy)
    proxy_command "$@"
    ;;
  proxy-docker)
    proxy_docker_command "$@"
    ;;
  reconnect)
    tailscale_reconnect "$@"
    ;;
  *)
    echo "Tailscale Development Environment Manager" >&2
    echo "" >&2
    echo "REQUIREMENTS:" >&2
    echo "  - Docker daemon must be running" >&2
    echo "  - jq (required for 'list' command)" >&2
    echo "" >&2
    echo "FIRST TIME SETUP:" >&2
    echo "  1. Ensure Docker is running: docker info" >&2
    echo "  2. Build the image: $0 build" >&2
    echo "  3. Run a container: $0 run --name mydev" >&2
    echo "" >&2
     echo "Usage: $0 {build|run|logs|shell|list|stop|wipe|proxy|reconnect} [options]" >&2
     echo "" >&2
     echo "Commands:" >&2
    echo "  build [--image-name <name>]" >&2
    echo "                             Build the Docker image with UTF-8 locale support." >&2
    echo "                             Optional: specify custom image name." >&2
    echo "" >&2
    echo "  run --name <name> [--data-dir <path>] [--image-name <name>] [--socks5-port <port>] [--auth-key <key>]" >&2
    echo "                             Run a new container with a unique name." >&2
    echo "                             Optional: specify custom data directory, image name, SOCKS5 port mapping, and auth key." >&2
    echo "" >&2
    echo "  logs --name <name>         Follow the logs of a container to get auth URL." >&2
    echo "" >&2
    echo "  shell --name <name> [--command 'cmd']" >&2
    echo "                             Get an interactive shell or run a command in a container." >&2
    echo "                             Default shell: /bin/bash" >&2
    echo "" >&2
    echo "  list                       List all running multi-ts containers." >&2
    echo "                             (requires jq)" >&2
    echo "" >&2
    echo "  stop --name <name>         Stop a specific container." >&2
    echo "" >&2
    echo "  wipe --name <name> [--data-dir <path>]" >&2
    echo "                             Wipe the data for a specific container." >&2
