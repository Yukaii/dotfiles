#!/bin/sh
#
# Navigate between files in a git diff buffer
#
# Requirements:
# - fzf (https://github.com/junegunn/fzf)
# - bat (https://github.com/sharkdp/bat) - for syntax highlighting
# - kks (kakoune-shell)
#
# Usage: Run this script when viewing a git diff output in Kakoune
# It will extract all file headers and let you jump to them

# Prefer user-provided KKS_BIN, otherwise fallback to whichever kks binary is in PATH
if [ -z "$KKS_BIN" ]; then
    KKS_BIN=$(command -v kks 2>/dev/null)
fi

if [ -z "$KKS_BIN" ]; then
    echo "kks binary not found. Set KKS_BIN or ensure kks is in PATH." >&2
    exit 1
fi

# Get current cursor line to pre-select closest entry
# Note: kks may show "unable to restore file permissions" errors from Kakoune
# These are harmless timing issues with temp file cleanup and can be ignored
current_line=$("$KKS_BIN" get "%val{cursor_line}" 2>/dev/null)

bufname=$("$KKS_BIN" get "%val{bufname}" 2>/dev/null)

# For the *git* buffer, give Kakoune a tiny moment to finish the write command
# The polling in kks will handle waiting for the actual content
if [ "$bufname" = "*git*" ] || [ "$bufname" = "*gh-pr-"* ]; then
    sleep 0.05  # Just 50ms to let Kakoune start writing
fi

# Read buffer content (kks cat handles write completion internally)
# Note: NOT redirecting stderr so we can see debug output
# Write directly to file to avoid slow shell string operations
diff_file=$(mktemp)
trap "rm -f '$diff_file'" EXIT

"$KKS_BIN" cat > "$diff_file"

# Extract file list with line numbers directly from file
file_list=$(grep -n "^diff --git" "$diff_file" | sed 's/:diff --git a\/.* b\//: /')
file_count=$(echo "$file_list" | wc -l | tr -d ' ')

# Find the closest file entry to current cursor position (the one before or at cursor)
# Default to 1 if current_line is empty or invalid
if [ -z "$current_line" ] || ! echo "$current_line" | grep -q '^[0-9]\+$'; then
    closest_index=1
else
    closest_index=$(echo "$file_list" | awk -F: -v cur="$current_line" '
        {
            line_num = $1
            if (line_num <= cur) {
                closest = NR
            }
        }
        END {
            if (closest > 0)
                print closest
            else
                print 1
        }
    ')
    # Ensure closest_index is not empty
    [ -z "$closest_index" ] && closest_index=1
fi

# Clamp closest_index to valid range [1, file_count]
if [ "$closest_index" -gt "$file_count" ]; then
    closest_index="$file_count"
fi
if [ "$closest_index" -lt 1 ] || [ -z "$file_count" ] || [ "$file_count" -eq 0 ]; then
    closest_index=1
fi

# Run fzf with bat preview and initial position
# Use pos() action as per fzf documentation (added in Dec 2022)
# Example from commit: seq 100 | fzf --sync --bind 'start:pos(10)'

selected=$(echo "$file_list" | \
    fzf --height 100% --prompt 'diff files> ' \
        --delimiter ':' \
        --with-nth='2..' \
        --preview "tail -n +{1} '$diff_file' | head -n 100 | bat --color=always --style=plain --language=diff" \
        --preview-window=right:60%:wrap \
        --bind "ctrl-d:preview-page-down,ctrl-u:preview-page-up" \
        --bind "start:pos($closest_index)")

if [ -n "$selected" ]; then
    line_num=$(echo "$selected" | cut -d: -f1)
    "$KKS_BIN" send "execute-keys '<esc>${line_num}gx'"
fi
