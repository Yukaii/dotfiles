#!/usr/bin/env bash

ghpro() {
    GH_FORCE_TTY=100% gh pr list --limit 300 | fzf --ansi --header 'ctrl-/: wrap preview' --bind 'ctrl-/:toggle-preview-wrap-word' --preview 'GH_FORCE_TTY=100% gh pr view {1}' --header-lines 4 --preview-window 'up:70%:wrap-word' | awk '{print substr($1, 2)}'
}

ghpro | xargs -I {} gh pr view {} --web
