#!/usr/bin/env bash
set -euo pipefail

sig_value="v4"

current_pane="${TMUX_PANE:-}"
if [[ -z "${current_pane}" ]]; then
  current_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
fi
if [[ -z "${current_pane}" ]]; then
  exit 1
fi

current_window_id="$(tmux display-message -p -t "${current_pane}" '#{window_id}')"
session_name="$(tmux display-message -p -t "${current_pane}" '#{session_name}')"
safe_session="$(printf '%s' "${session_name}" | tr -c '[:alnum:]_-' '_')"
store_session="__vscode_panel_store_${safe_session}"

clear_window_state() {
  tmux set-window-option -t "${current_window_id}" -u @vscode_panel_id 2>/dev/null || true
  tmux set-window-option -t "${current_window_id}" -u @vscode_panel_pid 2>/dev/null || true
  tmux set-window-option -t "${current_window_id}" -u @vscode_panel_sig 2>/dev/null || true
}

set_window_state() {
  local pane_id="$1"
  local pane_pid="$2"
  tmux set-window-option -t "${current_window_id}" @vscode_panel_id "${pane_id}"
  tmux set-window-option -t "${current_window_id}" @vscode_panel_pid "${pane_pid}"
  tmux set-window-option -t "${current_window_id}" @vscode_panel_sig "${sig_value}"
}

clear_parked_state() {
  tmux set-option -t "${session_name}" -u @vscode_panel_parked_id 2>/dev/null || true
  tmux set-option -t "${session_name}" -u @vscode_panel_parked_pid 2>/dev/null || true
}

set_parked_state() {
  local pane_id="$1"
  local pane_pid="$2"
  tmux set-option -t "${session_name}" @vscode_panel_parked_id "${pane_id}"
  tmux set-option -t "${session_name}" @vscode_panel_parked_pid "${pane_pid}"
}

ensure_store_session() {
  if ! tmux has-session -t "${store_session}" 2>/dev/null; then
    tmux new-session -d -s "${store_session}" -n "__panel_store__"
  fi
}

window_panel_id="$(tmux show-window-options -t "${current_window_id}" -v @vscode_panel_id 2>/dev/null || true)"
window_panel_pid="$(tmux show-window-options -t "${current_window_id}" -v @vscode_panel_pid 2>/dev/null || true)"
window_panel_sig="$(tmux show-window-options -t "${current_window_id}" -v @vscode_panel_sig 2>/dev/null || true)"

# Hide current panel (park it) when the tracked pane is still valid.
if [[ "${window_panel_sig}" == "${sig_value}" && -n "${window_panel_id}" && -n "${window_panel_pid}" ]]; then
  live_pid="$(tmux display-message -p -t "${window_panel_id}" '#{pane_pid}' 2>/dev/null || true)"
  if [[ "${live_pid}" == "${window_panel_pid}" ]]; then
    ensure_store_session
    tmux break-pane -d -s "${window_panel_id}" -t "${store_session}:"
    set_parked_state "${window_panel_id}" "${window_panel_pid}"
    clear_window_state
    exit 0
  fi
fi

clear_window_state

target_pane="${current_pane}"
parked_id="$(tmux show-options -t "${session_name}" -v @vscode_panel_parked_id 2>/dev/null || true)"
parked_pid="$(tmux show-options -t "${session_name}" -v @vscode_panel_parked_pid 2>/dev/null || true)"

if [[ -n "${parked_id}" && -n "${parked_pid}" ]]; then
  live_parked_pid="$(tmux display-message -p -t "${parked_id}" '#{pane_pid}' 2>/dev/null || true)"
  if [[ "${live_parked_pid}" == "${parked_pid}" ]]; then
    tmux join-pane -d -s "${parked_id}" -t "${target_pane}" -v -l 30%
    attached_id="$(tmux list-panes -t "${current_window_id}" -F '#{pane_id} #{pane_pid}' | awk -v pid="${parked_pid}" '$2==pid {print $1; exit}')"
    if [[ -n "${attached_id}" ]]; then
      set_window_state "${attached_id}" "${parked_pid}"
      clear_parked_state
      exit 0
    fi
  fi
fi

clear_parked_state

# No parked panel exists; create a new one.
cwd="$(tmux display-message -p -t "${current_pane}" '#{pane_current_path}')"
new_panel_id="$(tmux split-window -v -d -l 30% -c "${cwd}" -P -F '#{pane_id}')"
new_panel_pid="$(tmux display-message -p -t "${new_panel_id}" '#{pane_pid}')"
set_window_state "${new_panel_id}" "${new_panel_pid}"
