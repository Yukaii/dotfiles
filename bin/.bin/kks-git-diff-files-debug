#!/bin/sh
#
# Debug wrapper for kks-git-diff-files
# Keeps terminal open to see logs and captures stderr
#

echo "Starting kks-git-diff-files..."
echo ""
echo "=== kks stderr output will appear below ==="
echo ""

if kks-git-diff-files 2>&1; then
    echo ""
    echo "=== Execution complete ==="
    echo ""
    echo "Check debug logs:"
    echo "  /tmp/kks-git-diff-debug.log"
    echo ""
    tail -20 /tmp/kks-git-diff-debug.log 2>/dev/null || echo "  (file not found)"
    echo ""
    echo "Press ENTER to close..."
    read dummy
else
    exit_code=$?
    echo ""
    echo "ERROR: Script failed with exit code $exit_code"
    echo ""
    echo "=== /tmp/kks-git-diff-debug.log ==="
    tail -30 /tmp/kks-git-diff-debug.log 2>/dev/null || echo "  (file not found)"
    echo ""
    echo "=== /tmp/kks-readtmp-debug.log ==="
    tail -30 /tmp/kks-readtmp-debug.log 2>/dev/null || echo "  (file not found)"
    echo ""
    echo "Press ENTER to close..."
    read dummy
fi
