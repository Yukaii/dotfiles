#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<USAGE
Usage: $0 [-p profile] [-g groups] [-l lang] [-w]
  -p profile    Target profile/tab group name
  -g groups     Semicolon-separated profile groups (e.g. "Personal,Work;Shopping")
  -l lang       Menu language ("en" or "ja"; default: en)
  -w            Prioritize window finding over tab-group cycling
  -h            Show this help message
USAGE
  exit 1
}

TARGET_PROFILE=""
PROFILE_GROUPS=""
MENU_LANG="en"
PRIORITIZE_WINDOW="false"

while getopts ":p:g:l:wh" opt; do
  case $opt in
    p) TARGET_PROFILE=$OPTARG ;;
    g) PROFILE_GROUPS=$OPTARG ;;
    l) MENU_LANG=$OPTARG ;;
    w) PRIORITIZE_WINDOW="true" ;;
    h|*) usage ;;
  esac
done

osascript <<EOF
-- === Safari Profile/Tab Group Switcher ===

property profileGroupsString : "${PROFILE_GROUPS}"
property menuLang           : "${MENU_LANG}"
property prioritizeWindowFinding : ${PRIORITIZE_WINDOW}

on run
  set targetProfile to "${TARGET_PROFILE}"

  -- parse profile groups if given
  if profileGroupsString ≠ "" then
    set profileGroups to my parseProfileGroups(profileGroupsString)
  else
    set profileGroups to {}
  end if

  tell application "Safari"
    activate
    delay 0.1
    set currentWindows to every window
    set activeWindowName to name of first window
    set activeProfile to my extractProfileName(activeWindowName)

    if targetProfile is "" then
      -- cycle to next different profile
      repeat with w in currentWindows
        set thisProfile to my extractProfileName(name of w)
        if thisProfile ≠ activeProfile and thisProfile ≠ "" then
          set index of w to 1
          return
        end if
      end repeat
    else
      -- optionally prioritize window titles
      if prioritizeWindowFinding is true then
        repeat with w in currentWindows
          if my extractProfileName(name of w) is targetProfile then
            set index of w to 1
            return
          end if
        end repeat
      end if

      set targetGroup to my getProfileGroup(targetProfile, profileGroups)
      set activeGroup to my getProfileGroup(activeProfile, profileGroups)

      if targetGroup = activeGroup then
        my cycleTabGroupsUntilMatch(targetProfile)
      else
        -- try to find any window in targetGroup
        set found to false
        repeat with w in currentWindows
          set thisProfile to my extractProfileName(name of w)
          if thisProfile is in (item 2 of (my findGroupItem(targetGroup, profileGroups))) then
            set index of w to 1
            delay 0.05
            my cycleTabGroupsUntilMatch(targetProfile)
            set found to true
            exit repeat
          end if
        end repeat
        if not found then
          my cycleTabGroupsUntilMatch(targetProfile)
        end if
      end if
    end if
  end tell
end run

-- ===== Helpers copied verbatim from your original script =====

on parseProfileGroups(groupsString)
  set parsed to {}
  set AppleScript's text item delimiters to ";"
  set groupDefs to text items of groupsString
  repeat with gd in groupDefs
    set AppleScript's text item delimiters to ","
    set profilesList to text items of gd
    set AppleScript's text item delimiters to ""
    if (count of profilesList) > 0 then
      set groupName to my trim(item 1 of profilesList)
      set end of parsed to {groupName, profilesList}
    end if
  end repeat
  return parsed
end parseProfileGroups

on findGroupItem(targetName, groups)
  repeat with g in groups
    if item 1 of g is targetName then return g
  end repeat
  return {targetName, {targetName}}
end findGroupItem

on getProfileGroup(profileName, groups)
  repeat with g in groups
    repeat with p in item 2 of g
      if p is profileName then return item 1 of g
    end repeat
  end repeat
  return profileName
end getProfileGroup

on extractProfileName(windowName)
  try
    if windowName contains "—" then
      set AppleScript's text item delimiters to "—"
      set part to first text item of windowName
      set AppleScript's text item delimiters to ""
      return my trim(part)
    else
      return word 1 of windowName
    end if
  on error
    return ""
  end try
end extractProfileName

on cycleTabGroupsUntilMatch(targetGroupName)
  tell application "Safari"
    set tw to front window
    set tid to id of tw
    set initial to my getCurrentTabGroupName()
    if initial is targetGroupName then return true
    set attempts to 0
    repeat while attempts < 5
      set attempts to attempts + 1
      my moveToNextTabGroup()
      tell application "Safari" to set index of window id tid to 1
      delay 0.05
      if my getCurrentTabGroupName() is targetGroupName then
        tell application "Safari" to set index of window id tid to 1
        return true
      end if
    end repeat
    return false
  end tell
end cycleTabGroupsUntilMatch

on moveToNextTabGroup()
  set mi to my getMenuItems(menuLang)
  tell application "System Events"
    tell process "Safari"
      click menu (window of mi) of menu bar 1
      delay 0.05
      click menu item (nextGroup of mi) of menu (window of mi) of menu bar 1
    end tell
  end tell
end moveToNextTabGroup

on getMenuItems(lang)
  if lang is "ja" then
    return {window:"ウインドウ", nextGroup:"次のタブグループへ移動"}
  else
    return {window:"Window", nextGroup:"Show Next Tab Group"}
  end if
end getMenuItems

on getCurrentTabGroupName()
  tell application "Safari"
    try
      return my extractProfileName(name of front window)
    on error
      return ""
    end try
  end tell
end getCurrentTabGroupName

on trim(t)
  repeat while t begins with " "
    set t to text 2 thru -1 of t
  end repeat
  repeat while t ends with " "
    set t to text 1 thru -2 of t
  end repeat
  return t
end trim

EOF
