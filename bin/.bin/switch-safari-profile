#!/usr/bin/env osascript

(*
Safari Profile/Tab Group Switcher

USAGE:
  ./script.scpt [profile_name]

DESCRIPTION:
  This script manages Safari windows based on their profile/tab group names.
  - When run without arguments, it brings the first window from a different
    profile/tab group than the currently active one to the front.
  - When run with a profile name argument, it specifically brings a window
    from that profile/tab group to the front.

EXAMPLES:
  ./script.scpt             # Switch to any different profile/tab group
  ./script.scpt Work        # Switch specifically to the "Work" profile/tab group
  ./script.scpt Personal    # Switch specifically to the "Personal" profile/tab group

NOTE:
  This script extracts the profile/tab group name as the text before the "—" (em dash)
  in each Safari window's title.
*)

on run argv
  -- Default to empty string if no argument provided
  set targetProfile to ""
  if (count of argv) > 0 then
    set targetProfile to item 1 of argv
  end if

  tell application "Safari"
    set currentWindows to every window
    set activeWindowName to name of first window

    -- Extract the profile/tab group name (text before the em dash)
    set activeProfile to my extractProfileName(activeWindowName)

    -- If no specific target profile was provided, use the original behavior
    if targetProfile is equal to "" then
      repeat with i from 2 to count of currentWindows
        set thisWindowName to name of item i of currentWindows
        set thisProfile to my extractProfileName(thisWindowName)

        if thisProfile is not equal to activeProfile and thisProfile is not "" then
          set index of item i of currentWindows to 1
          exit repeat
        end if
      end repeat
    else
      -- Look specifically for the target profile
      repeat with i from 1 to count of currentWindows
        set thisWindowName to name of item i of currentWindows
        set thisProfile to my extractProfileName(thisWindowName)

        if thisProfile is equal to targetProfile then
          set index of item i of currentWindows to 1
          exit repeat
        end if
      end repeat
    end if
  end tell
end run

-- Helper function to extract profile/tab group name from window title
on extractProfileName(windowName)
  try
    -- Look for text before the em dash (—)
    if windowName contains "—" then
      set AppleScript's text item delimiters to "—"
      set profilePart to first text item of windowName
      set AppleScript's text item delimiters to ""
      -- Trim any whitespace
      return my trim(profilePart)
    else
      -- Fallback to first word if no em dash is found
      return word 1 of windowName
    end if
  on error
    return ""
  end try
end extractProfileName

-- Helper function to trim whitespace from beginning and end of text
on trim(theText)
  -- Remove leading whitespace
  repeat while theText begins with " "
    set theText to text 2 thru end of theText
  end repeat

  -- Remove trailing whitespace
  repeat while theText ends with " "
    set theText to text 1 thru ((length of theText) - 1) of theText
  end repeat

  return theText
end trim
