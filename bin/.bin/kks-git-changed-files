#!/bin/sh
#
# pick changed files from git status
#
# requires:
# - fzf (https://github.com/junegunn/fzf)
# - bat (https://github.com/sharkdp/bat)

history_file="$HOME/.cache/kks-git-changes-history"

[ -f "$history_file" ] || touch "$history_file"

repo_root=$(git rev-parse --show-toplevel)

{
    # Get tracked changes
    git status --porcelain | grep -v "^??" | sed 's/^...//'

    # Get and expand untracked files/directories
    git ls-files --others --exclude-standard
} | \
    fzf --multi --height 100% --prompt 'git changes> ' \
        --style=full \
        --header='[ctrl-/] toggle preview wrap' \
        --preview "bat --color=always --line-range=:500 --style plain $repo_root/{}" --history="$history_file" \
        --bind 'ctrl-/:toggle-preview-wrap-word' \
        --bind "ctrl-d:preview-page-down,ctrl-u:preview-page-up" |
    while read -r file; do
        kks edit "$repo_root/$file"
    done
