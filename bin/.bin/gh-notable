#!/bin/bash

# --- Default values ---
TARGET_REPO=""
USE_FIBONACCI=false
USE_PRIMES=false
USE_POWERS_OF_2=false

# --- Helper functions ---
print_usage() {
    echo "Usage: $0 [-R, --repo [HOST/]OWNER/REPO] [--fibonacci] [--primes] [--powers-of-2]"
    echo
    echo "Finds 'notable' PRs and issues (e.g., #1, #100, #222) in a GitHub repository."
    echo
    echo "Flags:"
    echo "  -R, --repo       Select a repository using the [HOST/]OWNER/REPO format."
    echo "                   If omitted, the repository in the current directory is used."
    echo "  --fibonacci      Include Fibonacci sequence numbers (1, 1, 2, 3, 5, 8, 13, ...)"
    echo "  --primes         Include prime numbers (2, 3, 5, 7, 11, 13, 17, 19, ...)"
    echo "  --powers-of-2    Include powers of 2 (1, 2, 4, 8, 16, 32, 64, ...)"
    echo
    echo "Note: If no sequence flags are specified, the default notable patterns are used:"
    echo "      - Powers of 10 (1, 10, 100, 1000, ...)"
    echo "      - Multiples of powers of 10 (2000, 3000, 4000, ...)"
    echo "      - Repeating digit patterns (111, 222, 333, ...)"
}

# Calculate display width of a string (accounting for CJK characters)
get_display_width() {
    local str="$1"
    local width=0
    local i=0

    # Convert string to array of characters
    while IFS= read -r -n1 char; do
        if [[ -n "$char" ]]; then
            # Get Unicode code point
            local code=$(printf "%d" "'$char" 2>/dev/null || echo 0)

            # Check if character is wide (CJK ranges and other wide characters)
            if (( (code >= 0x1100 && code <= 0x115F) ||
                  (code >= 0x2329 && code <= 0x232A) ||
                  (code >= 0x2E80 && code <= 0x2EFF) ||
                  (code >= 0x2F00 && code <= 0x2FDF) ||
                  (code >= 0x2FF0 && code <= 0x2FFF) ||
                  (code >= 0x3000 && code <= 0x303E) ||
                  (code >= 0x3041 && code <= 0x3096) ||
                  (code >= 0x30A1 && code <= 0x30FA) ||
                  (code >= 0x3105 && code <= 0x312D) ||
                  (code >= 0x3131 && code <= 0x318E) ||
                  (code >= 0x3190 && code <= 0x31BA) ||
                  (code >= 0x31C0 && code <= 0x31E3) ||
                  (code >= 0x31F0 && code <= 0x31FF) ||
                  (code >= 0x3200 && code <= 0x32FF) ||
                  (code >= 0x3300 && code <= 0x33FF) ||
                  (code >= 0x3400 && code <= 0x4DBF) ||
                  (code >= 0x4E00 && code <= 0x9FFF) ||
                  (code >= 0xA960 && code <= 0xA97F) ||
                  (code >= 0xAC00 && code <= 0xD7A3) ||
                  (code >= 0xD7B0 && code <= 0xD7FF) ||
                  (code >= 0xF900 && code <= 0xFAFF) ||
                  (code >= 0xFE10 && code <= 0xFE19) ||
                  (code >= 0xFE30 && code <= 0xFE6F) ||
                  (code >= 0xFF00 && code <= 0xFF60) ||
                  (code >= 0xFFE0 && code <= 0xFFE6) )); then
                ((width += 2))
            else
                ((width += 1))
            fi
        fi
    done < <(printf "%s" "$str" | fold -w1)

    echo "$width"
}

# Truncate string to fit display width (respecting character boundaries)
truncate_to_width() {
    local str="$1"
    local max_width="$2"
    local current_width=0
    local result=""
    local i=0

    while IFS= read -r -n1 char; do
        if [[ -n "$char" ]]; then
            local code=$(printf "%d" "'$char" 2>/dev/null || echo 0)
            local char_width=1

            # Check if character is wide
            if (( (code >= 0x1100 && code <= 0x115F) ||
                  (code >= 0x2329 && code <= 0x232A) ||
                  (code >= 0x2E80 && code <= 0x2EFF) ||
                  (code >= 0x2F00 && code <= 0x2FDF) ||
                  (code >= 0x2FF0 && code <= 0x2FFF) ||
                  (code >= 0x3000 && code <= 0x303E) ||
                  (code >= 0x3041 && code <= 0x3096) ||
                  (code >= 0x30A1 && code <= 0x30FA) ||
                  (code >= 0x3105 && code <= 0x312D) ||
                  (code >= 0x3131 && code <= 0x318E) ||
                  (code >= 0x3190 && code <= 0x31BA) ||
                  (code >= 0x31C0 && code <= 0x31E3) ||
                  (code >= 0x31F0 && code <= 0x31FF) ||
                  (code >= 0x3200 && code <= 0x32FF) ||
                  (code >= 0x3300 && code <= 0x33FF) ||
                  (code >= 0x3400 && code <= 0x4DBF) ||
                  (code >= 0x4E00 && code <= 0x9FFF) ||
                  (code >= 0xA960 && code <= 0xA97F) ||
                  (code >= 0xAC00 && code <= 0xD7A3) ||
                  (code >= 0xD7B0 && code <= 0xD7FF) ||
                  (code >= 0xF900 && code <= 0xFAFF) ||
                  (code >= 0xFE10 && code <= 0xFE19) ||
                  (code >= 0xFE30 && code <= 0xFE6F) ||
                  (code >= 0xFF00 && code <= 0xFF60) ||
                  (code >= 0xFFE0 && code <= 0xFFE6) )); then
                char_width=2
            fi

            # Check if adding this character would exceed the width
            if (( current_width + char_width > max_width )); then
                # If we have room for "..." (3 chars), add it
                if (( current_width + 3 <= max_width )); then
                    result+="..."
                elif (( current_width + 2 <= max_width )); then
                    result+=".."
                elif (( current_width + 1 <= max_width )); then
                    result+="."
                fi
                break
            fi

            result+="$char"
            ((current_width += char_width))
        fi
    done < <(printf "%s" "$str" | fold -w1)

    echo "$result"
}

# Pad string to specified display width
pad_to_width() {
    local str="$1"
    local target_width="$2"
    local current_width=$(get_display_width "$str")
    local padding_needed=$((target_width - current_width))

    if (( padding_needed > 0 )); then
        printf "%s%*s" "$str" "$padding_needed" ""
    else
        printf "%s" "$str"
    fi
}

# Generate Fibonacci sequence up to max_number
generate_fibonacci() {
    local max=$1
    local fib_numbers=()
    local a=1 b=1
    
    while (( a <= max )); do
        fib_numbers+=($a)
        local temp=$((a + b))
        a=$b
        b=$temp
    done
    
    printf "%s\n" "${fib_numbers[@]}"
}

# Check if a number is prime
is_prime() {
    local n=$1
    if (( n < 2 )); then
        return 1
    fi
    if (( n == 2 )); then
        return 0
    fi
    if (( n % 2 == 0 )); then
        return 1
    fi
    
    local i=3
    while (( i * i <= n )); do
        if (( n % i == 0 )); then
            return 1
        fi
        ((i += 2))
    done
    return 0
}

# Generate prime numbers up to max_number
generate_primes() {
    local max=$1
    local prime_numbers=()
    
    for (( i=2; i<=max; i++ )); do
        if is_prime $i; then
            prime_numbers+=($i)
        fi
    done
    
    printf "%s\n" "${prime_numbers[@]}"
}

# Generate powers of 2 up to max_number
generate_powers_of_2() {
    local max=$1
    local powers=()
    local power=1
    
    while (( power <= max )); do
        powers+=($power)
        ((power *= 2))
    done
    
    printf "%s\n" "${powers[@]}"
}

# --- Argument Parsing ---
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -R|--repo)
            if [[ -n "$2" ]]; then
                TARGET_REPO="$2"
                shift # past argument
                shift # past value
            else
                echo "Error: --repo flag requires a [HOST/]OWNER/REPO argument." >&2
                echo >&2
                print_usage
                exit 1
            fi
            ;;
        --fibonacci)
            USE_FIBONACCI=true
            shift
            ;;
        --primes)
            USE_PRIMES=true
            shift
            ;;
        --powers-of-2)
            USE_POWERS_OF_2=true
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Error: Unknown parameter passed: $1" >&2
            echo >&2
            print_usage
            exit 1
            ;;
    esac
done

# --- Prerequisite Checks ---
# 1. Check for GitHub CLI ('gh')
if ! command -v gh &> /dev/null; then
    echo "Error: The GitHub CLI ('gh') is not installed." >&2
    echo "Please install it from https://cli.github.com/ and authenticate with 'gh auth login'." >&2
    exit 1
fi

# 2. Check for 'jq'
if ! command -v jq &> /dev/null; then
    echo "Error: The JSON processor 'jq' is not installed." >&2
    echo "Please install it. (e.g., 'sudo apt-get install jq', 'brew install jq')" >&2
    exit 1
fi


# --- Repository Validation and Setup ---
if [[ -n "$TARGET_REPO" ]]; then
    GH_REPO_FLAG="-R $TARGET_REPO"
    if ! gh repo view "$TARGET_REPO" > /dev/null 2>&1; then
        echo "Error: Repository '$TARGET_REPO' not found or you lack permission to view it." >&2
        exit 1
    fi
    repo_name=$(gh repo view "$TARGET_REPO" --json nameWithOwner | jq -r .nameWithOwner)
else
    GH_REPO_FLAG=""
    if ! gh repo view > /dev/null 2>&1; then
        echo "Error: Not a GitHub repository." >&2
        echo "Please run this script from a repository directory or specify one with the -R, --repo flag." >&2
        exit 1
    fi
    repo_name=$(gh repo view --json nameWithOwner | jq -r .nameWithOwner)
fi
echo "🔍 Finding notable issues and pull requests in: $repo_name"
echo

# --- Main Logic ---
# Determine the highest number by finding the latest PR and issue.
# This version pipes the JSON output to the 'jq' command for compatibility.
latest_pr=$(gh pr list $GH_REPO_FLAG --limit 1 --json number | jq '.[0].number // 0')
latest_issue=$(gh issue list $GH_REPO_FLAG --limit 1 --json number | jq '.[0].number // 0')
max_number=$(( latest_pr > latest_issue ? latest_pr : latest_issue ))

if [[ $max_number -eq 0 ]]; then
    echo "Could not find any pull requests or issues in this repository."
    exit 0
fi

# Generate the list of notable numbers
notable_numbers=()

# Check if any sequence flags were specified
sequence_flags_specified=false
if [[ "$USE_FIBONACCI" == true || "$USE_PRIMES" == true || "$USE_POWERS_OF_2" == true ]]; then
    sequence_flags_specified=true
fi

# Add sequences based on flags
if [[ "$USE_FIBONACCI" == true ]]; then
    while IFS= read -r num; do
        if [[ -n "$num" ]]; then
            notable_numbers+=($num)
        fi
    done < <(generate_fibonacci $max_number)
fi

if [[ "$USE_PRIMES" == true ]]; then
    while IFS= read -r num; do
        if [[ -n "$num" ]]; then
            notable_numbers+=($num)
        fi
    done < <(generate_primes $max_number)
fi

if [[ "$USE_POWERS_OF_2" == true ]]; then
    while IFS= read -r num; do
        if [[ -n "$num" ]]; then
            notable_numbers+=($num)
        fi
    done < <(generate_powers_of_2 $max_number)
fi

# If no sequence flags were specified, use default patterns
if [[ "$sequence_flags_specified" == false ]]; then
    # Add powers of 10: 1, 10, 100, 1000, 10000, etc.
    i=1
    while (( i <= max_number )); do
        notable_numbers+=($i)
        ((i*=10))
    done

    # Add multiples of powers of 10: 2000, 3000, 4000, etc.
    power=1000
    while (( power <= max_number )); do
        for multiple in {2..9}; do
            num=$((multiple * power))
            if (( num <= max_number )); then
                notable_numbers+=($num)
            fi
        done
        ((power*=10))
    done

    # Add repeating digit patterns starting from 111: 111, 222, 333, etc. (skip 11-99)
    for digit in {1..9}; do
        # Start from 3-digit repeating numbers (111, 222, etc.)
        num=$((digit * 111))
        while (( num <= max_number )); do
            notable_numbers+=($num)
            num=$((num * 10 + digit))
        done
    done
fi

unique_sorted_numbers=($(printf "%s\n" "${notable_numbers[@]}" | sort -n | uniq))

# Calculate optimal column widths based on terminal width
TERM_WIDTH=$(tput cols 2>/dev/null || echo 120)
TYPE_WIDTH=7
NUMBER_WIDTH=8
AUTHOR_WIDTH=20
PADDING=12  # Account for table separators and padding

# Calculate available width for title column
TITLE_WIDTH=$((TERM_WIDTH - TYPE_WIDTH - NUMBER_WIDTH - AUTHOR_WIDTH - PADDING))

# Ensure minimum and maximum title width
if [[ $TITLE_WIDTH -lt 30 ]]; then
    TITLE_WIDTH=30
elif [[ $TITLE_WIDTH -gt 80 ]]; then
    TITLE_WIDTH=80
fi

# Adjust author width if terminal is very narrow
if [[ $TERM_WIDTH -lt 100 ]]; then
    AUTHOR_WIDTH=15
    TITLE_WIDTH=$((TERM_WIDTH - TYPE_WIDTH - NUMBER_WIDTH - AUTHOR_WIDTH - PADDING))
    if [[ $TITLE_WIDTH -lt 25 ]]; then
        TITLE_WIDTH=25
    fi
fi

# Print table header
printf "| %-${TYPE_WIDTH}s | %-${NUMBER_WIDTH}s | %-${TITLE_WIDTH}s | %-${AUTHOR_WIDTH}s |\n" "Type" "Number" "Title" "Author"

# Create separator line
type_sep=$(printf "%*s" $((TYPE_WIDTH + 1)) | tr ' ' '-')
number_sep=$(printf "%*s" $((NUMBER_WIDTH + 1)) | tr ' ' '-')
title_sep=$(printf "%*s" $((TITLE_WIDTH + 1)) | tr ' ' '-')
author_sep=$(printf "%*s" $((AUTHOR_WIDTH + 1)) | tr ' ' '-')
printf "|:%s|:%s|:%s|:%s|\n" "$type_sep" "$number_sep" "$title_sep" "$author_sep"

for num in "${unique_sorted_numbers[@]}"; do
    if (( num > max_number )); then
        continue
    fi

    # First check if it's a pull request
    pr_data=$(gh pr view "$num" $GH_REPO_FLAG --json title,author 2>/dev/null)

    if [[ -n "$pr_data" ]]; then
        title=$(echo "$pr_data" | jq -r .title)
        author=$(echo "$pr_data" | jq -r .author.login)
        type="PR"

        # Truncate title if needed (Unicode-aware)
        title_display_width=$(get_display_width "$title")
        if (( title_display_width > TITLE_WIDTH )); then
            title=$(truncate_to_width "$title" "$TITLE_WIDTH")
        fi

        # Truncate author if needed (Unicode-aware)
        author_display_width=$(get_display_width "$author")
        if (( author_display_width > AUTHOR_WIDTH )); then
            author=$(truncate_to_width "$author" "$AUTHOR_WIDTH")
        fi

        # Format with proper Unicode-aware padding
        padded_type=$(pad_to_width "$type" "$TYPE_WIDTH")
        padded_title=$(pad_to_width "$title" "$TITLE_WIDTH")
        padded_author=$(pad_to_width "$author" "$AUTHOR_WIDTH")

        printf "| %s | #%-${NUMBER_WIDTH}s | %s | %s |\n" "$padded_type" "$num" "$padded_title" "$padded_author"
    else
        # If not a PR, try to get as an issue
        issue_data=$(gh issue view "$num" $GH_REPO_FLAG --json title,author 2>/dev/null)

        if [[ -n "$issue_data" ]]; then
            title=$(echo "$issue_data" | jq -r .title)
            author=$(echo "$issue_data" | jq -r .author.login)
            type="Issue"

            # Truncate title if needed (Unicode-aware)
            title_display_width=$(get_display_width "$title")
            if (( title_display_width > TITLE_WIDTH )); then
                title=$(truncate_to_width "$title" "$TITLE_WIDTH")
            fi

            # Truncate author if needed (Unicode-aware)
            author_display_width=$(get_display_width "$author")
            if (( author_display_width > AUTHOR_WIDTH )); then
                author=$(truncate_to_width "$author" "$AUTHOR_WIDTH")
            fi

            # Format with proper Unicode-aware padding
            padded_type=$(pad_to_width "$type" "$TYPE_WIDTH")
            padded_title=$(pad_to_width "$title" "$TITLE_WIDTH")
            padded_author=$(pad_to_width "$author" "$AUTHOR_WIDTH")

            printf "| %s | #%-${NUMBER_WIDTH}s | %s | %s |\n" "$padded_type" "$num" "$padded_title" "$padded_author"
        fi
    fi
done
