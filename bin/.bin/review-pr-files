#!/usr/bin/env bash
#
# review-pr-files.sh — Interactive or argument-driven PR/commit file reviewer with bat previews

set -euo pipefail

# Function: check for required dependencies
check_dependencies() {
  local missing_deps=()

  # Check for required commands
  if ! command -v gh &> /dev/null; then
    missing_deps+=("gh (GitHub CLI)")
  fi

  if ! command -v fzf &> /dev/null; then
    missing_deps+=("fzf (fuzzy finder)")
  fi

  if ! command -v bat &> /dev/null; then
    missing_deps+=("bat (syntax highlighter)")
  fi

  if ! command -v git &> /dev/null; then
    missing_deps+=("git (version control)")
  fi

  # Report missing dependencies
  if [[ ${#missing_deps[@]} -gt 0 ]]; then
    echo "❌ Missing required dependencies:" >&2
    for dep in "${missing_deps[@]}"; do
      echo "  - $dep" >&2
    done
    echo "" >&2
    echo "Please install the missing dependencies and try again." >&2
    echo "Installation suggestions:" >&2

    for dep in "${missing_deps[@]}"; do
      case "$dep" in
        *"gh"*)
          echo "  - gh: brew install gh" >&2
          ;;
        *"fzf"*)
          echo "  - fzf: brew install fzf" >&2
          ;;
        *"bat"*)
          echo "  - bat: brew install bat" >&2
          ;;
        *"git"*)
          echo "  - git: brew install git (or use Xcode Command Line Tools)" >&2
          ;;
      esac
    done

    exit 1
  fi
}

# Function: pick a PR interactively
pick_pr() {
  gh pr list --limit 100 --json number,title,headRefName \
    --template '{{range .}}{{.number}} {{.title}} ({{.headRefName}})\n{{end}}' |
    fzf --ansi \
        --header="Select a PR (or pass it as \`$0 <number>\`) | ctrl-/: wrap preview" \
        --prompt="PR> " \
        --preview="gh pr view {1} --json body --template '{{.body}}' | bat --style=plain --paging=never" \
        --preview-window="right:50%,wrap-word,border-left" \
        --track --id-nth=1 \
        --bind 'ctrl-/:toggle-preview-wrap-word' \
        --bind 'ctrl-o:execute(gh pr view {1} --web)' \
        --bind 'ctrl-d:reload(gh pr list --limit 100 --json number,title,headRefName --template '\''{{range .}}{{.number}} {{.title}} ({{.headRefName}})\n{{end}}'\'')' \
        --nth=1 \
        --delimiter=' ' \
        --with-nth=1,2 |
    awk '{print $1}'
}

# Function: pick a commit interactively
pick_commit() {
  git log --oneline --color=always | fzf --ansi \
        --header="Select a commit (or pass it as \`$0 <hash>\`) | ctrl-/: wrap preview" \
        --prompt="Commit> " \
        --preview="git show {1} --patch --quiet | bat --style=plain --paging=never" \
        --preview-window="right:50%,wrap-word,border-left" \
        --bind 'ctrl-/:toggle-preview-wrap-word' \
        --bind 'ctrl-d:reload(git log --oneline --color=always)'
}

# Function: get preview command for PR files
get_pr_preview_command() {
  local pr_id="$1"
  local base_ref head_ref head_repo head_sha

  # Get PR details including the head SHA
  base_ref=$(gh pr view "$pr_id" --json baseRefName --template '{{.baseRefName}}')
  head_ref=$(gh pr view "$pr_id" --json headRefName --template '{{.headRefName}}')
  head_repo=$(gh pr view "$pr_id" --json headRepositoryOwner --template '{{.headRepositoryOwner.login}}')
  head_sha=$(gh pr view "$pr_id" --json headRefOid --template '{{.headRefOid}}')

  # Determine the correct remote for the head branch (handle forks)
  local current_repo=$(gh repo view --json owner --template '{{.owner.login}}')
  local head_remote_ref
  if [[ "$head_repo" == "$current_repo" ]]; then
    head_remote_ref="origin/$head_ref"
  else
    head_remote_ref="$head_repo/$head_ref"
  fi

  # Try different strategies to find a valid reference
  local head_ref_to_use=""
  local use_fallback=false
  
  # Strategy 1: Try the remote ref if it exists
  if git rev-parse --verify "$head_remote_ref" &>/dev/null; then
    head_ref_to_use="$head_remote_ref"
  # Strategy 2: Try the SHA if it exists locally
  elif git rev-parse --verify "$head_sha" &>/dev/null; then
    head_ref_to_use="$head_sha"
  else
    use_fallback=true
  fi

  # Check if we can use merge-base (both refs must exist locally)
  if [[ "$use_fallback" == "true" ]] || ! git rev-parse --verify "origin/$base_ref" &>/dev/null || ! git merge-base "origin/$base_ref" "$head_ref_to_use" &>/dev/null; then
    # Strategy 3: Fallback to gh pr diff for cases where commit isn't available locally
    # Since gh pr diff doesn't support file paths, we need to extract the file diff manually
    echo "gh pr diff $pr_id --color=always | grep -A 1000 \"diff --git.*{}\" | grep -B 1000 -m 1 \"^diff --git\" | head -n -1"
    return
  fi

  # Use merge-base approach like pr-diff alias for accurate comparison
  echo "git diff \$(git merge-base origin/$base_ref $head_ref_to_use) $head_ref_to_use --color=always -- {}"
}

# Function: get preview command for commit files
get_commit_preview_command() {
  local commit_id="$1"
  echo "git diff $commit_id~1 $commit_id --color=always -- {}"
}

# Function: get file list for PR
get_pr_files() {
  local pr_id="$1"
  gh pr diff "$pr_id" --name-only
}

# Function: get file list for commit
get_commit_files() {
  local commit_id="$1"
  git diff "$commit_id~1" "$commit_id" --name-only
}

# Function: browse files with fzf preview
browse_files() {
  local file_list_cmd="$1"
  local preview_cmd="$2"

  eval "$file_list_cmd" | fzf -m --ansi --header='ctrl-/: wrap preview' --bind 'ctrl-/:toggle-preview-wrap-word' --preview-window='right:60%,wrap-word,border-left' --preview="$preview_cmd"
}

# Function: determine mode and ID from arguments or interactive selection
determine_mode_and_id() {
  local arg="${1:-}"
  local mode="" id=""

  if [[ "$arg" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    mode="commit"
    id="$arg"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    mode="pr"
    id="$arg"
  else
    # No valid argument: prompt user to choose mode
    mode=$(printf "%s\n%s" pr commit | fzf --header="Select mode:" --prompt="Mode> ")
    case "$mode" in
      pr)
        id=$(pick_pr)
        ;;
      commit)
        id=$(pick_commit | awk '{print $1}')
        ;;
      *)
        echo "No mode selected." >&2
        exit 1
        ;;
    esac
  fi

  # Validate selection
  if [[ -z "$id" ]]; then
    echo "No identifier selected." >&2
    exit 1
  fi

  echo "$mode $id"
}

# Main execution
main() {
  # Check dependencies before proceeding
  check_dependencies

  local mode_and_id preview_cmd file_list_cmd

  # Determine mode and identifier
  read -r MODE ID <<< "$(determine_mode_and_id "${1:-}")"

  # Set up commands based on mode
  case "$MODE" in
    pr)
      preview_cmd=$(get_pr_preview_command "$ID")
      file_list_cmd="get_pr_files $ID"
      ;;
    commit)
      preview_cmd=$(get_commit_preview_command "$ID")
      file_list_cmd="get_commit_files $ID"
      ;;
    *)
      echo "Invalid mode: $MODE" >&2
      exit 1
      ;;
  esac

  # Browse files with preview
  browse_files "$file_list_cmd" "$preview_cmd"
}

# Run main function with all arguments
main "$@"
