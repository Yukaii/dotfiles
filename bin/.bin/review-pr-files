#!/usr/bin/env bash
#
# review-pr-files.sh — Interactive or argument-driven PR/commit file reviewer with bat previews

set -euo pipefail

# Function: pick a PR interactively
pick_pr() {
  gh pr list --limit 100 --json number,title,headRefName \
    --template '{{range .}}{{.number}} {{.title}} ({{.headRefName}})\n{{end}}' |
    fzf --ansi \
        --header="Select a PR (or pass it as \`$0 <number>\`)" \
        --prompt="PR> " \
        --preview="gh pr view {1} --json body --template '{{.body}}' | bat --style=plain --paging=never" \
        --preview-window="right:50%,border-left" \
        --bind 'ctrl-o:execute(gh pr view {1} --web)' \
        --bind 'ctrl-d:reload(gh pr list --limit 100 --json number,title,headRefName --template '\''{{range .}}{{.number}} {{.title}} ({{.headRefName}})\n{{end}}'\'')' \
        --nth=1 \
        --delimiter=' ' \
        --with-nth=1,2 |
    awk '{print $1}'
}

# Function: pick a commit interactively
pick_commit() {
  git log --oneline --color=always | fzf --ansi \
        --header="Select a commit (or pass it as \`$0 <hash>\`)" \
        --prompt="Commit> " \
        --preview="git show {1} --patch --quiet | bat --style=plain --paging=never" \
        --preview-window="right:50%,border-left" \
        --bind 'ctrl-d:reload(git log --oneline --color=always)'
}

# Function: get preview command for PR files
get_pr_preview_command() {
  local pr_id="$1"
  local base_sha head_sha
  
  base_sha=$(gh pr view "$pr_id" --json baseRefOid --template '{{.baseRefOid}}')
  head_sha=$(gh pr view "$pr_id" --json headRefOid --template '{{.headRefOid}}')
  
  echo "git diff $base_sha $head_sha --color=always -- {}"
}

# Function: get preview command for commit files
get_commit_preview_command() {
  local commit_id="$1"
  echo "git diff $commit_id~1 $commit_id --color=always -- {}"
}

# Function: get file list for PR
get_pr_files() {
  local pr_id="$1"
  gh pr diff "$pr_id" --name-only
}

# Function: get file list for commit
get_commit_files() {
  local commit_id="$1"
  git diff "$commit_id~1" "$commit_id" --name-only
}

# Function: browse files with fzf preview
browse_files() {
  local file_list_cmd="$1"
  local preview_cmd="$2"
  
  eval "$file_list_cmd" | fzf -m --ansi --preview="$preview_cmd"
}

# Function: determine mode and ID from arguments or interactive selection
determine_mode_and_id() {
  local arg="${1:-}"
  local mode="" id=""
  
  if [[ "$arg" =~ ^[0-9a-fA-F]{7,40}$ ]]; then
    mode="commit"
    id="$arg"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    mode="pr"
    id="$arg"
  else
    # No valid argument: prompt user to choose mode
    mode=$(printf "%s\n%s" pr commit | fzf --header="Select mode:" --prompt="Mode> ")
    case "$mode" in
      pr)
        id=$(pick_pr)
        ;;
      commit)
        id=$(pick_commit | awk '{print $1}')
        ;;
      *)
        echo "No mode selected." >&2
        exit 1
        ;;
    esac
  fi
  
  # Validate selection
  if [[ -z "$id" ]]; then
    echo "No identifier selected." >&2
    exit 1
  fi
  
  echo "$mode $id"
}

# Main execution
main() {
  local mode_and_id preview_cmd file_list_cmd
  
  # Determine mode and identifier
  read -r MODE ID <<< "$(determine_mode_and_id "${1:-}")"
  
  # Set up commands based on mode
  case "$MODE" in
    pr)
      preview_cmd=$(get_pr_preview_command "$ID")
      file_list_cmd="get_pr_files $ID"
      ;;
    commit)
      preview_cmd=$(get_commit_preview_command "$ID")
      file_list_cmd="get_commit_files $ID"
      ;;
    *)
      echo "Invalid mode: $MODE" >&2
      exit 1
      ;;
  esac
  
  # Browse files with preview
  browse_files "$file_list_cmd" "$preview_cmd"
}

# Run main function with all arguments
main "$@"
