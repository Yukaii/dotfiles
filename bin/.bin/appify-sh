#!/usr/bin/env bash
# appify-sh - Turn TUI commands into native macOS .app bundles powered by Kitty, WezTerm, or Ghostty
#
# Backend Findings & Differences:
# - kitty:   Works best if you want full Kitty image protocol (inline images, avatars, album art).
#            Configured with -o confirm_os_window_close=0 for prompt-free launch and exit.
# - wezterm: Works well, prompt-free, and reliable.
# - ghostty: Launches a new Ghostty instance with the command as its initial
#            surface. The command and its arguments are passed as separate argv
#            entries so tools such as `fresh --help` are not collapsed into one
#            invalid command name. With --helper, a private Ghostty copy named
#            after the app is embedded under Resources/ and ad-hoc signed; its
#            Dock/Cmd-Tab label comes from that bundle's folder name. Ghostty's
#            upstream DockTilePlugin (hard-wired to com.mitchellh.ghostty) is
#            removed and the icon is baked into the bundle, so the generated app
#            gets its own name and icon instead of Ghostty's.
set -euo pipefail

NAME=""
ICON=""
TERMINAL="kitty"
OUTPUT_DIR="$HOME/Applications"
BUNDLE_ID=""
CWD=""
USE_SHELL=false
USE_HELPER=false
ENV_VARS=()
EXTRA_ARGS=()

usage() {
  cat <<EOF
Usage: appify-sh [options] [--] <command> [args...]

Options:
  -n, --name <name>          Application display name (default: derived from command)
  -i, --icon <path>          Path to icon (.png or .icns)
  -t, --terminal <engine>    Terminal backend: 'kitty' (default), 'wezterm', or 'ghostty'
  -o, --output <dir>         Output directory (default: ~/Applications)
  -b, --bundle-id <id>       Bundle Identifier (default: com.local.<name>)
  -e, --env <KEY=VAL>        Set environment variable (can be used multiple times)
  --cwd <path>               Initial working directory
  --shell                    Run command inside an interactive login shell
                             (loads .zprofile/.zshrc: mise, aliases, colours)
  --helper                   Ghostty only: bundle a private, ad-hoc signed
                             Ghostty app named after the app (own Dock name/icon)
  -h, --help                 Show this help message

Backends:
  kitty    (default) Works best if you want full Kitty image protocol (avatars, emotes, album art).
  wezterm  Works well, prompt-free, and reliable.
  ghostty  Opens a dedicated Ghostty window with the command as its initial surface.

Examples:
  appify-sh -n "Concord" -i /Applications/Discord.app/Contents/Resources/electron.icns -- concord
  appify-sh -n "SpotaTUI" -i /Applications/Spotify.app/Contents/Resources/AppIcon.icns -- spotatui
  appify-sh -n "Slk" -i /Applications/Slack.app/Contents/Resources/electron.icns -- slk
  appify-sh -n "Btop" -t wezterm -- btop
  appify-sh --helper -n "Fresh" -t ghostty -- fresh
EOF
  exit 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name)
      NAME="$2"
      shift 2
      ;;
    -i|--icon)
      ICON="$2"
      shift 2
      ;;
    -t|--terminal)
      TERMINAL="$2"
      shift 2
      ;;
    -o|--output)
      OUTPUT_DIR="$2"
      shift 2
      ;;
    -b|--bundle-id)
      BUNDLE_ID="$2"
      shift 2
      ;;
    -e|--env)
      ENV_VARS+=("$2")
      shift 2
      ;;
    --cwd)
      CWD="$2"
      shift 2
      ;;
    --shell)
      USE_SHELL=true
      shift
      ;;
    --helper)
      USE_HELPER=true
      shift
      ;;
    -h|--help)
      usage
      ;;
    --)
      shift
      EXTRA_ARGS=("$@")
      break
      ;;
    *)
      EXTRA_ARGS+=("$1")
      shift
      ;;
  esac
done

if [[ ${#EXTRA_ARGS[@]} -eq 0 ]]; then
  echo "Error: No command specified." >&2
  usage
fi

# Store external paths as absolute values because the generated launcher is
# normally started by Finder, whose working directory is not predictable.
if [[ -n "$ICON" && -f "$ICON" ]]; then
  ICON="$(cd "$(dirname "$ICON")" && pwd)/$(basename "$ICON")"
fi

if [[ "$USE_HELPER" == "true" && "$TERMINAL" != "ghostty" ]]; then
  echo "Error: --helper is only supported with the ghostty backend." >&2
  exit 1
fi

COMMAND="${EXTRA_ARGS[0]}"
CMD_ARGS=("${EXTRA_ARGS[@]:1}")

if [[ -z "$NAME" ]]; then
  NAME="$(basename "$COMMAND")"
fi

if [[ -z "$BUNDLE_ID" ]]; then
  SLUG="$(echo "$NAME" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '.' | sed 's/^\.//;s/\.$//')"
  BUNDLE_ID="com.local.${SLUG}"
fi

APP_BUNDLE="${OUTPUT_DIR}/${NAME}.app"
CONTENTS="${APP_BUNDLE}/Contents"
MACOS="${CONTENTS}/MacOS"
RESOURCES="${CONTENTS}/Resources"

mkdir -p "$OUTPUT_DIR"
rm -rf "$APP_BUNDLE"
mkdir -p "$MACOS" "$RESOURCES"

ICON_FILE=""
BUNDLED_ICON=""

# --- Icon Processing ---
if [[ -n "$ICON" && -f "$ICON" ]]; then
  if [[ "$ICON" == *.icns ]]; then
    cp "$ICON" "$RESOURCES/AppIcon.icns"
    ICON_FILE="AppIcon"
    BUNDLED_ICON="AppIcon.icns"
  else
    TEMP_DIR="$(mktemp -d)"
    ICONSET_DIR="${TEMP_DIR}/AppIcon.iconset"
    mkdir -p "$ICONSET_DIR"

    sips -z 16 16     "$ICON" --out "$ICONSET_DIR/icon_16x16.png" >/dev/null 2>&1 || true
    sips -z 32 32     "$ICON" --out "$ICONSET_DIR/icon_16x16@2x.png" >/dev/null 2>&1 || true
    sips -z 32 32     "$ICON" --out "$ICONSET_DIR/icon_32x32.png" >/dev/null 2>&1 || true
    sips -z 64 64     "$ICON" --out "$ICONSET_DIR/icon_32x32@2x.png" >/dev/null 2>&1 || true
    sips -z 128 128   "$ICON" --out "$ICONSET_DIR/icon_128x128.png" >/dev/null 2>&1 || true
    sips -z 256 256   "$ICON" --out "$ICONSET_DIR/icon_128x128@2x.png" >/dev/null 2>&1 || true
    sips -z 256 256   "$ICON" --out "$ICONSET_DIR/icon_256x256.png" >/dev/null 2>&1 || true
    sips -z 512 512   "$ICON" --out "$ICONSET_DIR/icon_256x256@2x.png" >/dev/null 2>&1 || true
    sips -z 512 512   "$ICON" --out "$ICONSET_DIR/icon_512x512.png" >/dev/null 2>&1 || true
    sips -z 1024 1024 "$ICON" --out "$ICONSET_DIR/icon_512x512@2x.png" >/dev/null 2>&1 || true

    if iconutil -c icns "$ICONSET_DIR" -o "$RESOURCES/AppIcon.icns" >/dev/null 2>&1; then
      ICON_FILE="AppIcon"
      BUNDLED_ICON="AppIcon.icns"
    else
      # Keep a usable icon when iconutil rejects an input image. macOS accepts
      # a PNG named by CFBundleIconFile, while other platforms can still run
      # this script for bundle generation/tests.
      cp "$ICON" "$RESOURCES/AppIcon.png"
      ICON_FILE="AppIcon.png"
      BUNDLED_ICON="AppIcon.png"
    fi
    rm -rf "$TEMP_DIR"
  fi
fi

if [[ -z "$ICON_FILE" ]]; then
  ICON_FILE="AppIcon"
fi

HELPER_APP=""
if [[ "$USE_HELPER" == "true" ]]; then
  GHOSTTY_SOURCE="${GHOSTTY_APP:-/Applications/Ghostty.app}"
  if [[ ! -d "$GHOSTTY_SOURCE" ]]; then
    echo "Error: Ghostty app not found at '$GHOSTTY_SOURCE'." >&2
    exit 1
  fi

  # LaunchServices derives the Dock/Cmd-Tab label and the tile icon from this
  # nested bundle, so name the folder after the app (e.g. "Fresh.app") rather
  # than a generic "Terminal.app", which macOS would display verbatim. Keep it
  # under Resources so the outer launcher can be moved as one self-contained app.
  HELPER_APP="$RESOURCES/${NAME}.app"
  ditto --norsrc --noqtn "$GHOSTTY_SOURCE" "$HELPER_APP"
  /usr/libexec/PlistBuddy \
    -c "Set :CFBundleIdentifier ${BUNDLE_ID}.terminal" \
    -c "Set :CFBundleName ${NAME}" \
    -c "Set :CFBundleDisplayName ${NAME}" \
    "$HELPER_APP/Contents/Info.plist"

  # Ghostty ships a DockTilePlugin hard-wired to the upstream
  # com.mitchellh.ghostty defaults suite (and plugin id), so a rebranded copy
  # can never feed it an icon; it resets the tile to the built-in Ghostty icon.
  # Drop the plugin and drive the tile icon from the bundle instead.
  /usr/libexec/PlistBuddy \
    -c "Delete :NSDockTilePlugIn" \
    "$HELPER_APP/Contents/Info.plist" >/dev/null 2>&1 || true
  # CFBundleIconName points at Ghostty's asset catalog; point the bundle at our
  # own icon so Dock and Finder show the app's icon, not Ghostty's.
  /usr/libexec/PlistBuddy \
    -c "Delete :CFBundleIconName" \
    "$HELPER_APP/Contents/Info.plist" >/dev/null 2>&1 || true
  if [[ -n "$BUNDLED_ICON" ]]; then
    cp "$RESOURCES/$BUNDLED_ICON" "$HELPER_APP/Contents/Resources/$BUNDLED_ICON"
    /usr/libexec/PlistBuddy \
      -c "Set :CFBundleIconFile AppIcon" \
      "$HELPER_APP/Contents/Info.plist"
  fi

  # Homebrew/Ghostty bundles may carry Finder resource forks. Strip those
  # before re-signing the renamed copy; codesign rejects resource forks.
  xattr -cr "$HELPER_APP" 2>/dev/null || true
  codesign --remove-signature "$HELPER_APP" >/dev/null 2>&1 || true
  if ! codesign --force --deep --sign - "$HELPER_APP" >/dev/null 2>&1; then
    echo "Error: failed to ad-hoc sign the bundled Ghostty helper." >&2
    exit 1
  fi
fi

# --- Info.plist ---
cat <<EOF > "$CONTENTS/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>launcher</string>
    <key>CFBundleIdentifier</key>
    <string>${BUNDLE_ID}</string>
    <key>CFBundleName</key>
    <string>${NAME}</string>
    <key>CFBundleDisplayName</key>
    <string>${NAME}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>${ICON_FILE}</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIconFiles</key>
    <array>
        <string>${ICON_FILE}</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
EOF

# --- Command argument preparation ---
# `%q` produces shell syntax that round-trips each argument, including spaces,
# quotes, and the `--` arguments commonly used by TUI tools. The generated
# launcher reconstructs an array and passes it directly to the terminal.
shell_join() {
  local arg quoted
  for arg in "$@"; do
    printf -v quoted '%q' "$arg"
    printf '%s ' "$quoted"
  done
}

RUN_SCRIPT="$(shell_join "$COMMAND" "${CMD_ARGS[@]}")"
if [[ "$USE_SHELL" == "true" ]]; then
  # Keep the shell lookup for the generated launcher to resolve at runtime.
  # Finder-launched apps do not always inherit SHELL, so use zsh as the macOS
  # default. Login + interactive flags load the same startup files as a
  # terminal window (mise, aliases, colour settings, and shell integration).
  RUN_ARGS='"${SHELL:-/bin/zsh}" -ilc '"$(printf '%q' "$RUN_SCRIPT")"
else
  RUN_ARGS="$RUN_SCRIPT"
fi

# --- Inherit Environment Variables ---
# Convert $HOME in current PATH to \$HOME for user/machine portability
INHERITED_PATH="${PATH//${HOME}/\$HOME}"

ENV_EXPORTS=""
for env_entry in "${ENV_VARS[@]+"${ENV_VARS[@]}"}"; do
  ENV_EXPORTS="${ENV_EXPORTS}export ${env_entry}"$'\n'
done

# --- Backend Launcher ---
if [[ "$TERMINAL" == "kitty" ]]; then
  CWD_OPT=""
  if [[ -n "$CWD" ]]; then
    CWD_OPT="-d \"$CWD\""
  fi

  cat <<EOF > "$MACOS/launcher"
#!/usr/bin/env bash
export PATH="${INHERITED_PATH}:\$PATH"
${ENV_EXPORTS}
KITTY_BIN="\$(command -v kitty 2>/dev/null || echo "/Applications/kitty.app/Contents/MacOS/kitty")"
exec "\$KITTY_BIN" \
  --title "$NAME" \
  -o confirm_os_window_close=0 \
  ${CWD_OPT} \
  -- ${RUN_ARGS}
EOF

elif [[ "$TERMINAL" == "wezterm" ]]; then
  CWD_OPT=""
  if [[ -n "$CWD" ]]; then
    CWD_OPT="--cwd \"$CWD\""
  fi

  cat <<EOF > "$MACOS/launcher"
#!/usr/bin/env bash
export PATH="${INHERITED_PATH}:\$PATH"
${ENV_EXPORTS}
WEZTERM_BIN="\$(command -v wezterm 2>/dev/null || echo "/opt/homebrew/bin/wezterm")"
exec "\$WEZTERM_BIN" start --class "$NAME" ${CWD_OPT} -- ${RUN_ARGS}
EOF

elif [[ "$TERMINAL" == "ghostty" ]]; then
  cat <<EOF > "$MACOS/launcher"
#!/usr/bin/env bash
export PATH="${INHERITED_PATH}:\$PATH"
${ENV_EXPORTS}
APP_ROOT="\$(cd "\$(dirname "\$0")/.." && pwd)"
if [[ "$USE_HELPER" == "true" ]]; then
  GHOSTTY_APP="\$APP_ROOT/Resources/${NAME}.app"
else
  GHOSTTY_APP="\${GHOSTTY_APP:-/Applications/Ghostty.app}"
fi
RUN_ARGS=( ${RUN_ARGS} )
GHOSTTY_ARGS=(
  --title=$(printf '%q' "$NAME")
  --window-save-state=never
  --quit-after-last-window-closed=true
  --confirm-close-surface=false
)
if [[ -n "${CWD}" ]]; then
  GHOSTTY_ARGS+=(--working-directory=$(printf '%q' "${CWD}"))
fi
exec open -na "\$GHOSTTY_APP" --args "\${GHOSTTY_ARGS[@]}" -e "\${RUN_ARGS[@]}"
EOF

else
  echo "Error: Unknown terminal backend '$TERMINAL'. Use 'kitty', 'wezterm', or 'ghostty'." >&2
  exit 1
fi

chmod +x "$MACOS/launcher"
touch "$APP_BUNDLE"

# Ask LaunchServices to refresh the bundle record immediately so Finder and
# Spotlight pick up a newly generated icon without requiring a logout.
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
if [[ -x "$LSREGISTER" ]]; then
  "$LSREGISTER" -f "$APP_BUNDLE" >/dev/null 2>&1 || true
fi

echo "✅ Successfully created application: ${APP_BUNDLE}"
