#!/usr/bin/env bash
# unsplash-cli-viewer
# Minimal TUI for browsing Unsplash in Kitty.
# Requires: bash (≥3.2), curl, jq, kitty-multi (expecting PNGs)
# Optional: convert (ImageMagick) or sips (macOS) for non-PNG images.

set -euo pipefail
IFS=$'\n' # Important for loops reading lines

API="https://api.unsplash.com"
if [[ -z "${UNSPLASH_ACCESS_KEY:-}" ]]; then
  echo "Error: please export UNSPLASH_ACCESS_KEY" >&2
  exit 1
fi
KEY="$UNSPLASH_ACCESS_KEY"

COL_ID=""      # optional collection ID
FULL=0         # fullscreen toggle
IDX=0          # current index
declare -a URLS DESC
LAST_URL=""    # track last downloaded URL
LAST_DOWNLOADED_FILE="" # Path to the raw downloaded file
LAST_DISPLAY_FILE=""    # Path to the file actually passed to kitty-multi (might be a converted PNG)

# Check for conversion tool
CONVERSION_TOOL=""
if command -v convert >/dev/null 2>&1; then # ImageMagick
    CONVERSION_TOOL="convert"
elif command -v sips >/dev/null 2>&1; then # macOS sips
    CONVERSION_TOOL="sips"
else
    echo "Warning: No image conversion tool (ImageMagick 'convert' or macOS 'sips') found." >&2
    echo "Non-PNG images from Unsplash might not display correctly with the current kitty-multi." >&2
fi

# get terminal size
term_size=$(stty size 2>/dev/null || echo "24 80") # Provide fallback if stty fails
term_rows=${term_size% *}
term_cols=${term_size#* }

# calculate 1-based coord from absolute or percentage
calc_coord() {
  local v="$1" dim="$2" n c
  if [[ "$v" == *% ]]; then
    n=${v%\%}
    # Ensure n is a valid number for percentage calculation
    if ! [[ "$n" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then n=0; fi
    (( $(echo "$n < 0" | bc -l) )) && n=0
    (( $(echo "$n > 100" | bc -l) )) && n=100
    c=$(printf "%.0f" "$(echo "$n * $dim / 100" | bc -l)") # Use bc for float math then round
  else
    # Ensure v is a number if it's not a percentage
    if ! [[ "$v" =~ ^[0-9]+$ ]]; then v=1; fi
    c=$v
  fi
  (( c < 1 )) && c=1
  # For percentages, if calculated c > dim, it should be dim. For absolute, let it be.
  if [[ "$v" == *% ]] && (( c > dim )); then c=$dim; fi
  printf "%s" "$c"
}

fetch_photo() {
  if [[ -n $COL_ID ]]; then
    resp=$(curl -fsSL -H "Authorization: Client-ID $KEY" \
      "$API/collections/$COL_ID/photos?per_page=30")
  else
    resp=$(curl -fsSL -H "Authorization: Client-ID $KEY" \
      "$API/photos/random?count=9") # Fetch 9 for the 3x3 grid
  fi
  
  if [[ -z "$resp" ]]; then
    echo "Error: Failed to fetch photos from Unsplash. Check API key or network." >&2
    URLS=() DESC=() IDX=0
    return
  fi

  # Clear previous arrays before populating
  URLS=() 
  DESC=()

  while IFS= read -r l; do URLS+=("$l"); done < <(
    jq -r '(if type=="object" then [.] else . end) # Handle single object or array
           | .[].urls.regular // empty' <<<"$resp" # Use // empty if urls.regular is missing
  )
  while IFS= read -r l; do DESC+=("$l"); done < <(
    jq -r '(if type=="object" then [.] else . end)
           | .[] | (.user.name // "Unknown User") + " – " + ( .description // "no description" )' <<<"$resp"
  )
  IDX=0
}

draw() {
  clear
  if (( ${#URLS[@]} == 0 || IDX < 0 || IDX >= ${#URLS[@]} )); then
    echo "Fetching photos..." >&2
    fetch_photo
    if (( ${#URLS[@]} == 0 )); then
        echo "No photos to display. Check API key/network or try again." >&2
        echo "Press any key to try fetching or q to quit." >&2
        return
    fi
    # Ensure IDX is valid after fetch
    (( IDX < 0 )) && IDX=0
    (( IDX >= ${#URLS[@]} )) && IDX=$((${#URLS[@]} - 1))
    # If fetch_photo still resulted in no URLs, it would have returned.
    # If it populated, IDX might be 0 for a new list.
  fi

  local url desc
  # Defensive check for array bounds, though fetch_photo should handle empty URLS
  if (( ${#URLS[@]} > 0 && IDX < ${#URLS[@]} )); then
      url=${URLS[IDX]}
      desc=${DESC[IDX]}
  else
      echo "Error: Invalid photo index or no photos available. Attempting to refresh." >&2
      fetch_photo # Try to recover
      # Re-check after fetch
      if (( ${#URLS[@]} == 0 || IDX < 0 || IDX >= ${#URLS[@]} )); then
          echo "Still no photos after refresh. Exiting draw." >&2
          return
      fi
      url=${URLS[IDX]}
      desc=${DESC[IDX]}
  fi


  local file_to_display=""

  if [[ "$url" != "$LAST_URL" || -z "$LAST_DISPLAY_FILE" || ! -f "$LAST_DISPLAY_FILE" ]]; then
    # Clean up previous temp files
    [[ -n "$LAST_DOWNLOADED_FILE" && -f "$LAST_DOWNLOADED_FILE" ]] && rm -f "$LAST_DOWNLOADED_FILE"
    # Only remove LAST_DISPLAY_FILE if it's different from LAST_DOWNLOADED_FILE and exists
    if [[ "$LAST_DISPLAY_FILE" != "$LAST_DOWNLOADED_FILE" && -n "$LAST_DISPLAY_FILE" && -f "$LAST_DISPLAY_FILE" ]]; then
      rm -f "$LAST_DISPLAY_FILE"
    fi
    
    local temp_template_download="uspx-download-XXXXXX"
    local downloaded_file
    if mktemp --help 2>&1 | grep -q -- "-t "; then
      downloaded_file=$(mktemp -t "$temp_template_download")
    else
      downloaded_file=$(mktemp "/tmp/$temp_template_download")
    fi
    LAST_DOWNLOADED_FILE="$downloaded_file"

    echo "Downloading: $url to $downloaded_file" >&2
    if curl -fsL "$url" -o "$downloaded_file"; then
      if [[ ! -s "$downloaded_file" ]]; then
        echo "Error: Downloaded file is empty. URL: $url" >&2; rm -f "$downloaded_file"; LAST_URL=""; LAST_DISPLAY_FILE=""; sleep 1; return
      fi
      echo "Download complete. Size: $(wc -c < "$downloaded_file") bytes" >&2

      local file_type
      file_type=$(file -b --mime-type "$downloaded_file")
      echo "Detected MIME type: $file_type for $downloaded_file" >&2

      if [[ "$file_type" == "image/png" ]]; then
        file_to_display="$downloaded_file"
      elif [[ -n "$CONVERSION_TOOL" ]]; then
        local temp_template_png="uspx-converted-XXXXXX.png" # Ensure PNG extension for clarity
        local png_temp_file
        if mktemp --help 2>&1 | grep -q -- "-t "; then
            png_temp_file=$(mktemp -t "$temp_template_png")
        else
            png_temp_file=$(mktemp "/tmp/$temp_template_png")
        fi
        echo "Converting $file_type to PNG: $png_temp_file" >&2
        if [[ "$CONVERSION_TOOL" == "convert" ]]; then
          if convert "$downloaded_file" "$png_temp_file"; then
            file_to_display="$png_temp_file"
          else
            echo "Error: ImageMagick conversion failed. Using original." >&2; rm -f "$png_temp_file"; file_to_display="$downloaded_file"
          fi
        elif [[ "$CONVERSION_TOOL" == "sips" ]]; then
          if sips -s format png "$downloaded_file" --out "$png_temp_file" >/dev/null 2>&1; then
            file_to_display="$png_temp_file"
          else
            echo "Error: sips conversion failed. Using original." >&2; rm -f "$png_temp_file"; file_to_display="$downloaded_file"
          fi
        fi
      else
        echo "Warning: Non-PNG image ($file_type) and no conversion tool. Attempting with original (may fail)." >&2
        file_to_display="$downloaded_file"
      fi
      LAST_URL="$url"
      LAST_DISPLAY_FILE="$file_to_display"
    else
      echo "Error: curl failed to download $url (exit code: $?)" >&2
      [[ -f "$downloaded_file" ]] && rm -f "$downloaded_file"; LAST_URL=""; LAST_DISPLAY_FILE=""; sleep 1; return
    fi
  else
    # URL hasn't changed, use the last known display file
    file_to_display="$LAST_DISPLAY_FILE"
  fi

  if [[ -z "$file_to_display" || ! -f "$file_to_display" ]]; then
    echo "Error: No valid image file to display ($file_to_display missing for $url)." >&2
    LAST_URL=""; LAST_DISPLAY_FILE=""; sleep 1; return # Force re-evaluation next cycle
  fi

  local kitty_id="$IDX" # Unique ID for Kitty protocol for this image instance
  local placement_opts
  if (( FULL )); then
    placement_opts="0%,0%,c=${term_cols},r=${term_rows}"
  else
    local slot=$(( IDX % 9 )) # Ensure we cycle through 9 slots for the 3x3 grid
    local cr=$(( slot / 3 )) cc=$(( slot % 3 ))
    local w=$(( term_cols / 3 )) h=$(( term_rows / 3 ))
    local r_pct=$(( cr * 100 / 3 )) c_pct=$(( cc * 100 / 3 ))
    placement_opts="${r_pct}%,${c_pct}%,c=${w},r=${h}"
  fi

  echo "Executing: kitty-multi \"$file_to_display\" \"$kitty_id\" \"$placement_opts\"" >&2
  if ! kitty-multi "$file_to_display" "$kitty_id" "$placement_opts"; then
    echo "Error: kitty-multi failed. Check path or image format (expected PNG by kitty-multi)." >&2; sleep 1
  fi

  echo "[$((IDX+1))/${#URLS[@]}] ${desc:0:term_cols}" >&2
  echo "←/p  →/n  z=toggle fullscreen  q=quit" >&2
}

main_loop() {
  stty -echo -icanon min 1 time 0
  trap 'stty sane; clear; [[ -n $LAST_DOWNLOADED_FILE && -f $LAST_DOWNLOADED_FILE ]] && rm -f "$LAST_DOWNLOADED_FILE"; if [[ "$LAST_DISPLAY_FILE" != "$LAST_DOWNLOADED_FILE" && -n "$LAST_DISPLAY_FILE" && -f "$LAST_DISPLAY_FILE" ]]; then rm -f "$LAST_DISPLAY_FILE"; fi; echo "Exited."; exit' INT TERM EXIT

  local k 
  draw 

  while read -rsn1 k; do
    local state_changed=0 
    case "$k" in
      q) break ;;
      h|p) 
        if (( IDX > 0 )); then IDX=$((IDX-1)); state_changed=1
        else echo "Already at the first image of this batch." >&2; fi
        ;;
      l|n) 
        if (( IDX < ${#URLS[@]} - 1 )); then IDX=$((IDX+1)); state_changed=1
        else echo "Fetching next set of photos..." >&2; fetch_photo; state_changed=1; fi
        ;;
      z) FULL=$((1-FULL)); state_changed=1 ;;
      $'\x1b') 
        read -rsn1 -t0.01 k_esc_part1 
        read -rsn1 -t0.01 k_esc_part2 
        if [[ "$k_esc_part1" == "[" ]]; then
          case "$k_esc_part2" in
            D) if (( IDX > 0 )); then IDX=$((IDX-1)); state_changed=1; else echo "Already at first image." >&2; fi ;;
            C) if (( IDX < ${#URLS[@]} - 1 )); then IDX=$((IDX+1)); state_changed=1; else echo "Fetching next set..." >&2; fetch_photo; state_changed=1; fi ;;
          esac
        fi
        ;;
    esac
    if (( state_changed )); then draw; fi
  done
}

if [[ "${1:-}" == "--collection" ]]; then
  if [[ -n "${2:-}" ]]; then
    COL_ID=$2; shift 2
  else
    echo "Error: --collection option requires an ID." >&2; exit 1
  fi
fi

for cmd in curl jq kitty-multi file; do # Added 'file' to deps check
  command -v $cmd >/dev/null || { echo "$cmd required" >&2; exit 1; }
done

fetch_photo
main_loop
