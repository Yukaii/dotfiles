#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ghlmpr [pr_number|pr_url] [-- <lumen diff args...>]

Interactively pick a PR using fzf (via `gh pr list`) and open it in `lumen diff`.

Examples:
  ghlmpr
  ghlmpr 123
  ghlmpr https://github.com/owner/repo/pull/123
  ghlmpr -- --watch
  ghlmpr 123 -- --file README.md
EOF
}

die() {
  echo "ghlmpr: $*" >&2
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

pick_pr() {
  GH_FORCE_TTY=100% gh pr list --limit 300 |
    fzf --ansi \
      --header 'ctrl-/: wrap preview' \
      --bind 'ctrl-/:toggle-preview-wrap-word' \
      --preview 'GH_FORCE_TTY=100% gh pr view {1}' \
      --header-lines 4 \
      --preview-window 'up:70%:wrap-word' |
    awk '{print substr($1, 2)}'
}

ghlmpr() {
  require_cmd gh
  require_cmd fzf
  require_cmd lumen

  local pr_ref=""
  local -a lumen_args=()

  while (($#)); do
    case "$1" in
    -h | --help)
      usage
      return 0
      ;;
    --)
      shift
      lumen_args+=("$@")
      break
      ;;
    -*)
      lumen_args+=("$1")
      shift
      ;;
    *)
      if [[ -z "$pr_ref" ]]; then
        pr_ref="$1"
      else
        lumen_args+=("$1")
      fi
      shift
      ;;
    esac
  done

  if [[ -z "$pr_ref" ]]; then
    pr_ref="$(pick_pr)"
  fi

  [[ -n "$pr_ref" ]] || die "no PR selected"

  if ((${#lumen_args[@]} > 0)); then
    exec lumen diff "$pr_ref" "${lumen_args[@]}"
  else
    exec lumen diff "$pr_ref"
  fi
}

ghlmpr "$@"
