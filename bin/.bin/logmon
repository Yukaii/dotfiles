#!/usr/bin/env bash
# start_with_event_stream.sh
# Run any command, mirror STDOUT to stdout.log (and screen), mirror STDERR to errors.log (and screen),
# and open a second terminal that tails stdout.log and greps for "event".

set -euo pipefail

# Show help
show_help() {
    cat << EOF
logmon - Run commands with log monitoring

USAGE:
    $0 [OPTIONS] [--] COMMAND...

DESCRIPTION:
    Runs a command while mirroring STDOUT to stdout.log and STDERR to errors.log.
    Opens a second terminal that tails stdout.log and optionally greps for patterns.

OPTIONS:
    -h, --help          Show this help message
    --grep PATTERN      Pattern to grep for in event stream (default: show all)
    --                  End of options (use before commands starting with -)

ENVIRONMENT VARIABLES:
    STDOUT_LOG          Output log file (default: stdout.log)
    ERRORS_LOG          Error log file (default: errors.log)
    TERMINAL_HOLD       Hold terminal open after exit (default: 1)
    STDOUT_LOG_MAX_SIZE Rotate STDOUT_LOG when exceeding this size (bytes, supports K/M/G; default: disabled)
    STDOUT_LOG_ROTATE_KEEP Number of rotated STDOUT logs to keep (default: 5)

EXAMPLES:
    $0 npm run dev                     # Run npm run dev with full log monitoring
    $0 --grep "error" python app.py   # Monitor only lines containing "error"
    $0 -- npm run -v build             # Use -- before commands starting with -

EOF
}

# -------- Config --------
STDOUT_LOG="${STDOUT_LOG:-stdout.log}"
ERRORS_LOG="${ERRORS_LOG:-errors.log}"
GREP_PATTERN="${GREP_PATTERN:-}"              # empty by default, show all output
TERMINAL_HOLD="${TERMINAL_HOLD:-1}"           # some terminals close on exit; set 1 to hold where supported
STDOUT_LOG_MAX_SIZE="${STDOUT_LOG_MAX_SIZE:-0}"    # support numeric or K/M/G suffix values
STDOUT_LOG_ROTATE_KEEP="${STDOUT_LOG_ROTATE_KEEP:-5}"
# ------------------------

parse_size_bytes() {
    local value="$1"

    if [[ -z "$value" ]]; then
        printf '0'
        return 0
    fi

    if [[ "$value" =~ ^[0-9]+$ ]]; then
        printf '%s' "$value"
        return 0
    fi

    if [[ "$value" =~ ^([0-9]+)([KkMmGg])$ ]]; then
        local number="${BASH_REMATCH[1]}"
        local unit="${BASH_REMATCH[2]}"
        case "$unit" in
            K|k)
                printf '%d' $((number * 1024))
                return 0
                ;;
            M|m)
                printf '%d' $((number * 1024 * 1024))
                return 0
                ;;
            G|g)
                printf '%d' $((number * 1024 * 1024 * 1024))
                return 0
                ;;
        esac
    fi

    echo "Error: invalid size value '$value'" >&2
    return 1
}

# Parse arguments
CMD=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --grep)
            if [[ $# -lt 2 ]]; then
                echo "Error: --grep requires a pattern argument"
                exit 1
            fi
            GREP_PATTERN="$2"
            shift 2
            ;;
        --)
            shift
            CMD+=("$@")
            break
            ;;
        *)
            CMD+=("$1")
            shift
            ;;
    esac
done

if [[ ${#CMD[@]} -eq 0 ]]; then
    echo "Error: No command specified"
    show_help
    exit 1
fi

if ! STDOUT_LOG_MAX_BYTES="$(parse_size_bytes "$STDOUT_LOG_MAX_SIZE")"; then
    exit 1
fi

if [[ ! "$STDOUT_LOG_ROTATE_KEEP" =~ ^[0-9]+$ ]]; then
    echo "Error: STDOUT_LOG_ROTATE_KEEP must be a non-negative integer" >&2
    exit 1
fi

if (( STDOUT_LOG_MAX_BYTES > 0 )) && ! command -v python3 >/dev/null 2>&1; then
    echo "Error: python3 is required when STDOUT_LOG_MAX_SIZE is set" >&2
    exit 1
fi

FIFO="/tmp/hm_stdout_fifo_$$"
if [[ -n "$GREP_PATTERN" ]]; then
    EVENT_CMD="tail -F \"$STDOUT_LOG\" | grep --line-buffered --color=never -E \"$GREP_PATTERN\""
else
    EVENT_CMD="tail -F \"$STDOUT_LOG\""
fi

cleanup() {
    rm -f "$FIFO"
}
trap cleanup EXIT INT TERM

# Create FIFO
mkfifo "$FIFO"

start_stdout_writer() {
    local fifo_path="$1"
    local log_path="$2"
    local max_bytes="$3"
    local keep_count="$4"

    if (( max_bytes > 0 )); then
        python3 - "$fifo_path" "$log_path" "$max_bytes" "$keep_count" <<'PYTHON'
import os
import sys

fifo, logfile, max_bytes, keep_count = sys.argv[1:]
max_bytes = int(max_bytes)
keep_count = int(keep_count)

log = None
current_size = 0


def reopen_log():
    global log, current_size
    log = open(logfile, 'ab', buffering=0)
    try:
        current_size = os.path.getsize(logfile)
    except OSError:
        current_size = 0


def rotate_logs():
    global log, current_size
    log.close()
    if keep_count > 0:
        for index in range(keep_count, 0, -1):
            src = f"{logfile}.{index}"
            dst = f"{logfile}.{index + 1}"
            try:
                if index == keep_count:
                    os.remove(src)
                else:
                    os.replace(src, dst)
            except FileNotFoundError:
                pass
            except OSError as exc:
                print(f"logmon: warning: rotate failure {src} -> {dst}: {exc}", file=sys.stderr)
        try:
            os.replace(logfile, f"{logfile}.1")
        except FileNotFoundError:
            pass
        except OSError as exc:
            print(f"logmon: warning: rotate failure {logfile} -> {logfile}.1: {exc}", file=sys.stderr)
    else:
        try:
            os.remove(logfile)
        except FileNotFoundError:
            pass
        except OSError as exc:
            print(f"logmon: warning: failed to remove {logfile}: {exc}", file=sys.stderr)
    reopen_log()


reopen_log()

try:
    with open(fifo, 'rb', buffering=0) as source:
        while True:
            chunk = source.read(8192)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            if max_bytes > 0 and current_size >= max_bytes:
                rotate_logs()
            log.write(chunk)
            current_size += len(chunk)
            if max_bytes > 0 and current_size >= max_bytes:
                rotate_logs()
finally:
    if log is not None:
        log.close()
PYTHON
    else
        tee -a "$log_path" <"$fifo_path"
    fi
}

# Background reader: read FIFO, tee (with optional rotation) to file and to stdout
start_stdout_writer "$FIFO" "$STDOUT_LOG" "$STDOUT_LOG_MAX_BYTES" "$STDOUT_LOG_ROTATE_KEEP" &
CAT_PID=$!

open_event_terminal() {
    local uname_s
    uname_s="$(uname -s 2>/dev/null || echo unknown)"

    # macOS: Terminal.app
    if [[ "$uname_s" == "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
        osascript <<EOF >/dev/null 2>&1 &
tell application "Terminal"
    activate
    do script "$EVENT_CMD"
end tell
EOF
        return 0
    fi

    # macOS: iTerm2
    if [[ "$uname_s" == "Darwin" ]] && command -v osascript >/dev/null 2>&1; then
        osascript <<EOF >/dev/null 2>&1 &
tell application "iTerm"
    create window with default profile
    tell current session of current window to write text "$EVENT_CMD"
end tell
EOF
        return 0
    fi

    # Linux: try common terminals
    if command -v gnome-terminal >/dev/null 2>&1; then
        gnome-terminal -- bash -lc "$EVENT_CMD" &
        return 0
    fi
    if command -v x-terminal-emulator >/dev/null 2>&1; then
        x-terminal-emulator -e bash -lc "$EVENT_CMD" &
        return 0
    fi
    if command -v konsole >/dev/null 2>&1; then
        if [[ "$TERMINAL_HOLD" == "1" ]]; then
            konsole --noclose -e bash -lc "$EVENT_CMD" &
        else
            konsole -e bash -lc "$EVENT_CMD" &
        fi
        return 0
    fi
    if command -v xfce4-terminal >/dev/null 2>&1; then
        xfce4-terminal --hold="$TERMINAL_HOLD" -e "bash -lc \"$EVENT_CMD\"" &
        return 0
    fi
    if command -v alacritty >/dev/null 2>&1; then
        alacritty -e bash -lc "$EVENT_CMD" &
        return 0
    fi
    if command -v urxvt >/dev/null 2>&1; then
        if [[ "$TERMINAL_HOLD" == "1" ]]; then
            urxvt -hold -e bash -lc "$EVENT_CMD" &
        else
            urxvt -e bash -lc "$EVENT_CMD" &
        fi
        return 0
    fi
    if command -v xterm >/dev/null 2>&1; then
        if [[ "$TERMINAL_HOLD" == "1" ]]; then
            xterm -hold -e "$EVENT_CMD" &
        else
            xterm -e "$EVENT_CMD" &
        fi
        return 0
    fi

    # WSL: try Windows Terminal
    if grep -qEi "(Microsoft|WSL)" /proc/version 2>/dev/null || [[ -n "${WSL_DISTRO_NAME-}" ]]; then
        if command -v wt.exe >/dev/null 2>&1; then
            wt.exe new-tab bash -lc "$EVENT_CMD" &
            return 0
        fi
        if command -v powershell.exe >/devnull 2>&1; then
            powershell.exe -NoProfile -Command "Start-Process wt -ArgumentList 'new-tab','bash -lc \"$EVENT_CMD\"'" >/dev/null 2>&1 &
            return 0
        fi
    fi

    return 1
}

if open_event_terminal; then
    echo "Opened event stream in a new terminal (following $STDOUT_LOG)."
else
    echo "Could not auto-open a terminal for the event stream."
    echo "Run this in another terminal to see only lines matching pattern:"
    echo "    $EVENT_CMD"
fi

# Run the command:
#   - STDOUT -> FIFO (so it goes through tee to stdout.log and your screen)
#   - STDERR -> tee appending to errors.log and back to real stderr
(
    exec 1> "$FIFO"
    exec 2> >(tee -a "$ERRORS_LOG" >&2)
    "${CMD[@]}"
)

# Let background cat flush and exit when FIFO closes
sleep 0.2
if kill -0 "$CAT_PID" 2>/dev/null; then
    kill "$CAT_PID" 2>/dev/null || true
fi

echo "Command exited. Logs: $STDOUT_LOG, $ERRORS_LOG"
