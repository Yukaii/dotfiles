#!/bin/sh
# Apply tmux chrome + statusline for the current macOS appearance.
# Called once from .tmux.conf at server start and on client-focus-in for
# live switching (mirrors the Kakoune FocusIn approach).
# Usage: appearance-tmux [dark|light|force]
# Exits quietly when the requested mode is already applied (unless "force").

if ! command -v tmux >/dev/null 2>&1; then
  exit 0
fi

case "$1" in
  dark | light) mode="$1" ;;
  force)
    mode="$(appearance-mode)"
    force=1
    ;;
  *) mode="$(appearance-mode)" ;;
esac

# tmux-palette reads theme.json on every launch. Point it at the per-mode file;
# the palette's theme switcher writes through the link, so each mode keeps
# its own pick. Runs before the early exit so a missing link gets repaired.
palette_dir="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-palette"
if [ -e "$palette_dir/theme-$mode.json" ] &&
  [ "$(readlink "$palette_dir/theme.json" 2>/dev/null)" != "theme-$mode.json" ]; then
  ln -sfn "theme-$mode.json" "$palette_dir/theme.json"
fi

if [ -z "$force" ]; then
  current="$(tmux show-environment -g APPEARANCE_MODE 2>/dev/null | cut -d= -f2-)"
  if [ "$current" = "$mode" ]; then
    exit 0
  fi
fi

tmux set-environment -g APPEARANCE_MODE "$mode" >/dev/null

if [ "$mode" = "light" ]; then
  SHIP="$HOME/.tmux/ship/light"
  PANE_BORDER="fg=#bdbfc9"
  PANE_ACTIVE="fg=#286983"
  POPUP_BORDER="fg=#a8a3b3"
  DOTBAR_FG="#9893a5"
  DOTBAR_CURRENT="#575279"
  DOTBAR_SESSION="#d7827e"
  DOTBAR_PREFIX="#56949f"
  TMUX_FZF_COLOR="light"
else
  SHIP="$HOME/.tmux/ship/dark"
  PANE_BORDER="fg=#2A2A37"
  PANE_ACTIVE="fg=#7FB4CA"
  POPUP_BORDER="fg=#565B66"
  DOTBAR_FG="#727169"
  DOTBAR_CURRENT="#dcd7ba"
  DOTBAR_SESSION="#c8c093"
  DOTBAR_PREFIX="#7fb4ca"
  TMUX_FZF_COLOR="dark"
fi

tmux set -g pane-border-style "$PANE_BORDER" >/dev/null
tmux set -g pane-active-border-style "$PANE_ACTIVE" >/dev/null
tmux set -g popup-border-style "$POPUP_BORDER" >/dev/null
tmux set -g @tmux-dotbar-fg "$DOTBAR_FG" >/dev/null
tmux set -g @tmux-dotbar-fg-current "$DOTBAR_CURRENT" >/dev/null
tmux set -g @tmux-dotbar-fg-session "$DOTBAR_SESSION" >/dev/null
tmux set -g @tmux-dotbar-fg-prefix "$DOTBAR_PREFIX" >/dev/null

tmux setenv -g TMUX_SHIP_LEFT_CONFIG "$SHIP/starship.toml" >/dev/null
tmux setenv -g TMUX_SHIP_RIGHT_CONFIG "$SHIP/.right.toml" >/dev/null
tmux setenv -g TMUX_SHIP_CENTER_CONFIG "$SHIP/.center.toml" >/dev/null
# tmuxship reads its input paths from the process environment, which was
# snapshotted when this run-shell spawned — export them explicitly.
export TMUX_SHIP_LEFT_CONFIG="$SHIP/starship.toml"
export TMUX_SHIP_RIGHT_CONFIG="$SHIP/.right.toml"
export TMUX_SHIP_CENTER_CONFIG="$SHIP/.center.toml"

# Server-wide env for tools spawned from tmux (popups, run-shell).
# FZF_DEFAULT_OPTS carries color only: bare fzf merges it with call-site
# flags, and shells layer their own full defaults on top.
tmux setenv -g FZF_DEFAULT_OPTS "--color=$TMUX_FZF_COLOR" >/dev/null
tmux setenv -g BAT_THEME "$(appearance-bat-theme "$mode")" >/dev/null

if command -v tmuxship >/dev/null 2>&1; then
  tmuxship apply >/dev/null 2>&1
fi
tmux refresh-client -S >/dev/null 2>&1
