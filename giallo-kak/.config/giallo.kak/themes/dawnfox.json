    {
      "name": "Type parameters",
      "scope": [
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#5ca7b4"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#ea9d34"
      }
    },
    {
      "name": "Property names (left hand assignments in json/yaml/css)",
