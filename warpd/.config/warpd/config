# Cursor + ripple color (pink)
cursor_color: #ff69b4ff
ripple_color: #ff69b4ff
cursor_entry_color: #ff69b4ff
normal_system_cursor: 1
cursor_halo_enabled: 1
cursor_entry_effect: 1
# cursor_pack: pointinghand

# Hint appearance
hint_border_color: #3a3a3a
hint_border_width: 1
# hint_bgcolor supports RGBA, last two hex digits are alpha
hint_bgcolor: #1c1c1eaa

# Hold mouse buttons while key pressed
hold_buttons: m , .

# Mouse buttons (including modifier clicks)
buttons: M-m
buttons: C-m
buttons: S-m
buttons: M-S-m

# Rapid auto-click while rapid_mode is active
rapid_mode: R
rapid_click_interval: 40
rapid_indicator_color: #ff69b480
rapid_indicator_width: 3
